/// Wiki Doc sources:
///   - https://wiki.osdev.org/PCI
///   - https://wiki.osdev.org/PCI#Configuration_Space_Access_Mechanism_.231
///   - https://wiki.osdev.org/PCI#Base_Address_Registers

#![trusted]

const pci_config_address: u16 = 0xCF8
const pci_config_data: u16 = 0xCFC
const pci_enable_bit: u32 = 0x80000000

const pci_max_bus: u32 = 256
const pci_max_device: u32 = 32
const pci_max_function: u32 = 8
const pci_no_vendor: u32 = 0xFFFF

const pci_vendor_offset: u32 = 0x00
const pci_command_offset: u32 = 0x04
const pci_class_offset: u32 = 0x08
const pci_header_offset: u32 = 0x0C
const pci_bar0_offset: u32 = 0x10
const pci_interrupt_offset: u32 = 0x3C
const pci_cap_pointer_offset: u32 = 0x34
const pci_status_has_caps: u32 = 0x100000
const pci_cap_mask: u32 = 0xFC
const pci_max_caps: u32 = 48

const pci_command_io: u32 = 0x1
const pci_command_memory: u32 = 0x2
const pci_command_bus_master: u32 = 0x4

const pci_multifunction: u32 = 0x80
const pci_bar_io: u32 = 0x1
const pci_bar_kind: u32 = 0x6
const pci_bar_64: u32 = 0x4
const pci_bar_memory_mask: u32 = 0xFFFFFFF0
const pci_bar_count: u32 = 6

struct PciAddr {
    bus: u32,
    device: u32,
    function: u32,
}

fn pci_read32(bus: u32, device: u32, function: u32, offset: u32) -> u32 {
    outl(pci_config_address, pci_enable_bit | (bus << 16) | (device << 11) | (function << 8) | (offset & 0xFC))
    return inl(pci_config_data)
}

fn pci_write32(bus: u32, device: u32, function: u32, offset: u32, value: u32) {
    outl(pci_config_address, pci_enable_bit | (bus << 16) | (device << 11) | (function << 8) | (offset & 0xFC))
    outl(pci_config_data, value)
}

fn pci_vendor(bus: u32, device: u32, function: u32) -> u32 {
    return pci_read32(bus, device, function, pci_vendor_offset) & 0xFFFF
}

fn pci_device_id(bus: u32, device: u32, function: u32) -> u32 {
    return pci_read32(bus, device, function, pci_vendor_offset) >> 16
}

fn pci_class(bus: u32, device: u32, function: u32) -> u32 {
    return pci_read32(bus, device, function, pci_class_offset) >> 8
}

fn pci_is_multifunction(bus: u32, device: u32) -> bool {
    return (pci_read32(bus, device, 0, pci_header_offset) >> 16) & pci_multifunction != 0
}

fn pci_function_count(bus: u32, device: u32) -> u32 {
    if pci_is_multifunction(bus, device) {
        return pci_max_function
    }
    return 1
}

fn pci_find(vendor: u32, device_a: u32, device_b: u32) -> Option<PciAddr> {
    return pci_find_nth(vendor, device_a, device_b, 0)
}

fn pci_find_nth(vendor: u32, device_a: u32, device_b: u32, n: u32) -> Option<PciAddr> {
    let mut seen: u32 = 0
    for bus in 0..pci_max_bus {
        for device in 0..pci_max_device {
            if pci_vendor(bus, device, 0) == pci_no_vendor {
                continue
            }
            for function in 0..pci_function_count(bus, device) {
                if pci_vendor(bus, device, function) != vendor {
                    continue
                }
                let id = pci_device_id(bus, device, function)
                if id == device_a || id == device_b {
                    if seen == n {
                        return Some(PciAddr { bus: bus, device: device, function: function })
                    }
                    seen += 1
                }
            }
        }
    }
    return None
}

fn pci_find_class(class: u32, n: u32) -> Option<PciAddr> {
    let mut seen: u32 = 0
    for bus in 0..pci_max_bus {
        for device in 0..pci_max_device {
            if pci_vendor(bus, device, 0) == pci_no_vendor {
                continue
            }
            for function in 0..pci_function_count(bus, device) {
                if pci_vendor(bus, device, function) == pci_no_vendor || pci_class(bus, device, function) != class {
                    continue
                }
                if seen == n {
                    return Some(PciAddr { bus: bus, device: device, function: function })
                }
                seen += 1
            }
        }
    }
    return None
}

fn pci_bar(a: &PciAddr, index: u32) -> u32 {
    return pci_read32(a.bus, a.device, a.function, pci_bar0_offset + index * 4)
}

fn pci_io_bar(a: &PciAddr, index: u32) -> u16 {
    let bar = pci_bar(a, index)
    if bar & pci_bar_io == 0 {
        return 0
    }
    return (bar & 0xFFFC) as u16
}

fn pci_config(a: &PciAddr, offset: u32) -> u32 {
    return pci_read32(a.bus, a.device, a.function, offset)
}

fn pci_config_byte(a: &PciAddr, offset: u32) -> u32 {
    return (pci_config(a, offset) >> ((offset & 3) * 8)) & 0xFF
}

fn pci_first_cap(a: &PciAddr) -> u32 {
    if pci_config(a, pci_command_offset) & pci_status_has_caps == 0 {
        return 0
    }
    return pci_config_byte(a, pci_cap_pointer_offset) & pci_cap_mask
}

fn pci_next_cap(a: &PciAddr, cap: u32) -> u32 {
    return pci_config_byte(a, cap + 1) & pci_cap_mask
}

fn pci_memory_bar(a: &PciAddr, index: u32) -> Option<u64> {
    if index >= pci_bar_count {
        return None
    }
    let low = pci_bar(a, index)
    if low & pci_bar_io != 0 {
        return None
    }
    let mut addr = (low & pci_bar_memory_mask) as u64
    if low & pci_bar_kind == pci_bar_64 && index + 1 < pci_bar_count {
        addr |= (pci_bar(a, index + 1) as u64) << 32
    }
    if addr == 0 {
        return None
    }
    return Some(addr)
}

fn pci_enable(a: &PciAddr) {
    let command = pci_read32(a.bus, a.device, a.function, pci_command_offset)
    let wanted = (command & 0xFFFF) | pci_command_io | pci_command_memory | pci_command_bus_master
    pci_write32(a.bus, a.device, a.function, pci_command_offset, wanted)
}

fn pci_irq_line(a: &PciAddr) -> u32 {
    return pci_read32(a.bus, a.device, a.function, pci_interrupt_offset) & 0xFF
}
