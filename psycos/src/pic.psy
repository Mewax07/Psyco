/// Wiki Doc sources:
///   - https://wiki.osdev.org/8259_PIC
///   - https://wiki.osdev.org/Programmable_Interval_Timer

#![trusted]

const pic1_command: u16 = 0x20
const pic1_data: u16 = 0x21
const pic2_command: u16 = 0xA0
const pic2_data: u16 = 0xA1

const irq_base: u8 = 32
const irq_cascade: u8 = 2

const icw1_init_with_icw4: u8 = 0x11
const icw3_slave_on_irq2: u8 = 4
const icw3_slave_identity: u8 = 2
const icw4_8086_mode: u8 = 1
const ocw3_read_isr: u8 = 0x0B
const pic_eoi_command: u8 = 0x20

const pit_channel0: u16 = 0x40
const pit_command: u16 = 0x43
const pit_mode2_lohi: u8 = 0x34
const pit_base_hz: u64 = 1193182
const pit_max_divisor: u64 = 65535

const io_wait_port: u16 = 0x80

static mut pic_mask_bits: u16 = 0xFFFF

fn io_wait() {
    outb(io_wait_port, 0)
}

fn pic_init() {
    outb(pic1_command, icw1_init_with_icw4)
    io_wait()
    outb(pic2_command, icw1_init_with_icw4)
    io_wait()
    outb(pic1_data, irq_base)
    io_wait()
    outb(pic2_data, irq_base + 8)
    io_wait()
    outb(pic1_data, icw3_slave_on_irq2)
    io_wait()
    outb(pic2_data, icw3_slave_identity)
    io_wait()
    outb(pic1_data, icw4_8086_mode)
    io_wait()
    outb(pic2_data, icw4_8086_mode)
    io_wait()

    pic_mask_bits = 0xFFFF & ~(1u16 << irq_cascade as u16)
    pic_write_mask()
}

fn pic_write_mask() {
    outb(pic1_data, (pic_mask_bits & 0xFF) as u8)
    outb(pic2_data, (pic_mask_bits >> 8) as u8)
}

fn pic_unmask(irq: u8) {
    if irq >= 16 {
        panic("pic_unmask: irq out of range")
    }
    pic_mask_bits &= ~(1u16 << irq as u16)
    pic_write_mask()
}

fn pic_mask(irq: u8) {
    if irq >= 16 {
        panic("pic_mask: irq out of range")
    }
    pic_mask_bits |= 1u16 << irq as u16
    pic_write_mask()
}

fn pic_masked(irq: u8) -> bool {
    return (pic_mask_bits >> (irq & 15) as u16) & 1 == 1
}

fn pic_eoi(irq: u8) {
    if irq >= 8 {
        outb(pic2_command, pic_eoi_command)
    }
    outb(pic1_command, pic_eoi_command)
}

fn pic_spurious(irq: u8) -> bool {
    if irq == 7 {
        outb(pic1_command, ocw3_read_isr)
        return inb(pic1_command) & 0x80 == 0
    }
    if irq == 15 {
        outb(pic2_command, ocw3_read_isr)
        if inb(pic2_command) & 0x80 == 0 {
            outb(pic1_command, pic_eoi_command)
            return true
        }
    }
    return false
}

fn pit_set_frequency(hz: u64) -> u64 {
    let mut divisor = pit_base_hz / hz
    if divisor < 1 {
        divisor = 1
    }
    if divisor > pit_max_divisor {
        divisor = pit_max_divisor
    }
    outb(pit_command, pit_mode2_lohi)
    outb(pit_channel0, (divisor & 0xFF) as u8)
    outb(pit_channel0, (divisor >> 8) as u8)
    return pit_base_hz / divisor
}
