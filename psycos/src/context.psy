/// Wiki Doc sources:
///   - https://wiki.osdev.org/Kernel_Multitasking

#![trusted]

const context_words: u64 = 8
const stack_align: u64 = 16

fn context_new(stack_top: u64, start: fn()) -> u64 {
    let top = stack_top & ~(stack_align - 1)
    let p = top as *mut u64
    p.sub(1).write(0)
    p.sub(2).write(start as u64)
    for i in 3..context_words as usize + 1 {
        p.sub(i).write(0)
    }
    return top - context_words * 8
}

fn context_switch_to(save: *mut u64, next: u64) {
    context_switch(save, next)
}

fn switch_address_space(cr3: u64) {
    if read_cr3() != cr3 {
        write_cr3(cr3)
    }
}
