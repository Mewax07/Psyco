/// Wiki Doc sources:
///   - https://wiki.osdev.org/Stack

#![trusted]

const kstack_size: usize = 65536
const kstack_fill: u8 = 0xA5

#[align(4096)]
static mut kstack: [u8; 65536]

fn kstack_bottom() -> usize {
    return kstack.as_ptr() as usize
}

fn kstack_top() -> usize {
    return kstack.as_ptr() as usize + kstack_size
}

fn run_on_kernel_stack(entry: fn()) {
    memset(kstack.as_mut_ptr(), kstack_fill, kstack_size)
    switch_stack(kstack_top(), entry)
}

fn kstack_used() -> usize {
    let mut untouched: usize = 0
    while untouched < kstack_size && kstack[untouched] == kstack_fill {
        untouched += 1
    }
    return kstack_size - untouched
}
