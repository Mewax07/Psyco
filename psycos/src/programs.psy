/// Wiki Doc sources:
///   - https://wiki.osdev.org/ELF

import "process.psy"

const program_count: usize = 6

static program_names: [Str; 6] = ["hello", "counter", "badmem", "privileged", "badptr", "spin"]

fn program_name(i: usize) -> Str {
    if i >= program_count {
        return ""
    }
    return program_names[i]
}

fn program_elf(i: usize) -> Str {
    match i {
        0 => return include_program("../user/hello.psy"),
        1 => return include_program("../user/counter.psy"),
        2 => return include_program("../user/badmem.psy"),
        3 => return include_program("../user/privileged.psy"),
        4 => return include_program("../user/badptr.psy"),
        5 => return include_program("../user/spin.psy"),
        _ => return "",
    }
}
