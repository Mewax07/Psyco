import "ps2.psy"
import "serial.psy"

const KEY_ENTER: u8 = 13
const KEY_BACKSPACE: u8 = 8
const KEY_ESCAPE: u8 = 27

static KEYMAP: [u8; 58] = [
    0, 27, '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '=', 8, '\t',
    'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']', 13, 0, 'a', 's',
    'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', '\'', '`', 0, '\\', 'z', 'x', 'c', 'v',
    'b', 'n', 'm', ',', '.', '/', 0, '*', 0, ' ',
]

static KEYMAP_SHIFT: [u8; 58] = [
    0, 27, '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '_', '+', 8, '\t',
    'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P', '{', '}', 13, 0, 'A', 'S',
    'D', 'F', 'G', 'H', 'J', 'K', 'L', ':', '"', '~', 0, '|', 'Z', 'X', 'C', 'V',
    'B', 'N', 'M', '<', '>', '?', 0, '*', 0, ' ',
]

static mut kbd_shift: u8 = 0
static mut kbd_ctrl: bool = false
static mut kbd_caps: bool = false
static mut kbd_extended: bool = false
static mut kbd_ps2: bool = false

fn kbd_init() {
    kbd_ps2 = ps2_init()
}

fn kbd_has_ps2() -> bool {
    return kbd_ps2
}

fn is_letter(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn kbd_translate(sc: u8) -> u8 {
    if sc == 0xE0 {
        kbd_extended = true
        return 0
    }
    let extended = kbd_extended
    kbd_extended = false
    let release = sc & 0x80 != 0
    let code = sc & 0x7F

    if code == 0x2A || code == 0x36 {
        if extended {
            return 0
        }
        let mut bit: u8 = 2
        if code == 0x2A { bit = 1 }
        if release {
            kbd_shift &= ~bit
        } else {
            kbd_shift |= bit
        }
        return 0
    }
    if code == 0x1D {
        kbd_ctrl = !release
        return 0
    }
    if release {
        return 0
    }
    if code == 0x3A {
        kbd_caps = !kbd_caps
        return 0
    }
    if extended {
        if code == 0x1C {
            return KEY_ENTER
        }
        if code == 0x35 {
            return '/'
        }
        return 0
    }
    if code as usize >= KEYMAP.len() {
        return 0
    }

    let mut c = KEYMAP[code as usize]
    if kbd_shift != 0 {
        c = KEYMAP_SHIFT[code as usize]
    }
    if kbd_caps && is_letter(c) { c ^= 0x20 }
    if kbd_ctrl && is_letter(c) { c = (c | 0x20) - 'a' + 1 }
    return c
}

fn read_key() -> u8 {
    loop {
        if kbd_ps2 {
            let sc = ps2_poll()
            if sc >= 0 {
                let c = kbd_translate(sc as u8)
                if c != 0 {
                    return c
                }
            }
        }
        let s = serial_poll()
        if s >= 0 {
            let c = s as u8
            if c == '\n' {
                return KEY_ENTER
            }
            if c == 127 {
                return KEY_BACKSPACE
            }
            return c
        }
        pause()
    }
}
