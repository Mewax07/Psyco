/// Wiki Doc sources:
///   - https://wiki.osdev.org/PS/2_Keyboard
///   - https://wiki.osdev.org/Keyboard
///
/// Keyboard (normal code): IRQ 1 -> scancode set 1 -> ASCII -> ring buffer.
/// read_key() reads that buffer and the serial port (polled at each wake
/// up, so at least 100 times per second).
/// Layout: US (QWERTY). QEMU sends keys by physical position, so an AZERTY
/// keyboard types as QWERTY.

import "ps2.psy"
import "serial.psy"
import "idt.psy"
import "pic.psy"

const key_enter: u8 = 13
const key_backspace: u8 = 8
const key_escape: u8 = 27
const key_delete_serial: u8 = 127

const keyboard_irq: u8 = 1
const keyboard_vector: usize = 33

// Scancode set 1.
const sc_left_shift: u8 = 0x2A
const sc_right_shift: u8 = 0x36
const sc_ctrl: u8 = 0x1D
const sc_caps_lock: u8 = 0x3A
const sc_extended: u8 = 0xE0
const sc_release: u8 = 0x80
const sc_enter: u8 = 0x1C
const sc_slash: u8 = 0x35

const kbd_buf_size: usize = 64

// Scancodes 0x00 to 0x39 (key press). 0 = key without a character.
static keymap: [u8; 58] = [
    0, 27, '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '=', 8, '\t',
    'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']', 13, 0, 'a', 's',
    'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', '\'', '`', 0, '\\', 'z', 'x', 'c', 'v',
    'b', 'n', 'm', ',', '.', '/', 0, '*', 0, ' ',
]

static keymap_shift: [u8; 58] = [
    0, 27, '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '_', '+', 8, '\t',
    'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P', '{', '}', 13, 0, 'A', 'S',
    'D', 'F', 'G', 'H', 'J', 'K', 'L', ':', '"', '~', 0, '|', 'Z', 'X', 'C', 'V',
    'B', 'N', 'M', '<', '>', '?', 0, '*', 0, ' ',
]

static mut kbd_shift: u8 = 0
static mut kbd_ctrl: bool = false
static mut kbd_caps: bool = false
static mut kbd_extended: bool = false
#[getter]
static mut kbd_ps2: bool = false

// Ring buffer: the IRQ writes at kbd_head, read_key reads at kbd_tail.
// One producer and one consumer: no lock needed.
static mut kbd_buf: [u8; 64]
static mut kbd_head: usize = 0
static mut kbd_tail: usize = 0
#[getter]
static mut kbd_dropped: u64 = 0
#[getter]
static mut kbd_irqs: u64 = 0

/// Installs vector 33 and unmasks IRQ 1 (call after irq_init).
fn kbd_init() {
    kbd_ps2 = ps2_init(true)
    if kbd_ps2 {
        idt_set_gate(keyboard_vector, irq_keyboard as u64, 0)
        pic_unmask(keyboard_irq)
    }
}

/// IRQ 1: translates the scancode and queues the character.
#[interrupt]
fn irq_keyboard(frame: &Frame) {
    kbd_irqs += 1
    let c = kbd_translate(ps2_read_data())
    if c != 0 {
        kbd_push(c)
    }
    pic_eoi(keyboard_irq)
}

/// Queues a character (dropped if the buffer is full).
fn kbd_push(c: u8) {
    let next = (kbd_head + 1) % kbd_buf_size
    if next == kbd_tail {
        kbd_dropped += 1
        return
    }
    kbd_buf[kbd_head] = c
    kbd_head = next
}

/// Next queued character, or -1 if the buffer is empty.
fn kbd_try_read() -> i32 {
    if kbd_tail == kbd_head {
        return -1
    }
    let c = kbd_buf[kbd_tail]
    kbd_tail = (kbd_tail + 1) % kbd_buf_size
    return c as i32
}

/// Number of queued characters.
fn kbd_pending() -> usize {
    return (kbd_head + kbd_buf_size - kbd_tail) % kbd_buf_size
}

/// True for a-z and A-Z.
fn is_letter(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

/// Handles one scancode; returns the character typed, or 0 if none.
fn kbd_translate(sc: u8) -> u8 {
    if sc == sc_extended {
        kbd_extended = true
        return 0
    }
    let extended = kbd_extended
    kbd_extended = false
    let release = sc & sc_release != 0
    let code = sc & ~sc_release

    if code == sc_left_shift || code == sc_right_shift {
        // "Fake" shift sent along with some extended keys.
        if extended {
            return 0
        }
        let mut bit: u8 = 2
        if code == sc_left_shift {
            bit = 1
        }
        if release {
            kbd_shift &= ~bit
        } else {
            kbd_shift |= bit
        }
        return 0
    }
    if code == sc_ctrl {
        kbd_ctrl = !release
        return 0
    }
    if release {
        return 0
    }
    if code == sc_caps_lock {
        kbd_caps = !kbd_caps
        return 0
    }
    if extended {
        // Keypad Enter and /. Arrows will come later.
        if code == sc_enter {
            return key_enter
        }
        if code == sc_slash {
            return '/'
        }
        return 0
    }
    if code as usize >= keymap.len() {
        return 0
    }

    let mut c = keymap[code as usize]
    if kbd_shift != 0 {
        c = keymap_shift[code as usize]
    }
    // Caps Lock only affects letters, and is reversed by Shift.
    if kbd_caps && is_letter(c) {
        c ^= 0x20
    }
    if kbd_ctrl && is_letter(c) {
        c = (c | 0x20) - 'a' + 1
    }
    return c
}

/// Waits for a key from the keyboard buffer or the serial port.
/// Enter gives 13 and Backspace gives 8, whatever the source.
/// Enables interrupts: the CPU sleeps (hlt) until the next IRQ.
fn read_key() -> u8 {
    loop {
        cli()
        let k = kbd_try_read()
        if k >= 0 {
            // I hope I never forget sti again
            sti()
            return k as u8
        }
        let s = serial_poll()
        if s >= 0 {
            sti()
            let c = s as u8
            if c == '\n' {
                return key_enter
            }
            if c == key_delete_serial {
                return key_backspace
            }
            return c
        }
        // sti then hlt with nothing in between: no IRQ can slip between
        // the buffer check and going to sleep.
        sti()
        hlt()
    }
}
