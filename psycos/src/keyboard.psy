import "ps2.psy"
import "serial.psy"
import "idt.psy"
import "pic.psy"

const KEY_ENTER: u8 = 13
const KEY_BACKSPACE: u8 = 8
const KEY_ESCAPE: u8 = 27

static KEYMAP: [u8; 58] = [
    0, 27, '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '=', 8, '\t',
    'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']', 13, 0, 'a', 's',
    'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', '\'', '`', 0, '\\', 'z', 'x', 'c', 'v',
    'b', 'n', 'm', ',', '.', '/', 0, '*', 0, ' ',
]

static KEYMAP_SHIFT: [u8; 58] = [
    0, 27, '!', '@', '#', '$', '%', '^', '&', '*', '(', ')', '_', '+', 8, '\t',
    'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P', '{', '}', 13, 0, 'A', 'S',
    'D', 'F', 'G', 'H', 'J', 'K', 'L', ':', '"', '~', 0, '|', 'Z', 'X', 'C', 'V',
    'B', 'N', 'M', '<', '>', '?', 0, '*', 0, ' ',
]

static mut kbd_shift: u8 = 0
static mut kbd_ctrl: bool = false
static mut kbd_caps: bool = false
static mut kbd_extended: bool = false
static mut kbd_ps2: bool = false

static mut kbd_buf: [u8; 64]
static mut kbd_head: usize = 0
static mut kbd_tail: usize = 0
static mut kbd_dropped: u64 = 0
static mut kbd_irqs: u64 = 0

fn kbd_init() {
    kbd_ps2 = ps2_init(true)
    if kbd_ps2 {
        idt_set_gate(33, irq_keyboard as u64, 0)
        pic_unmask(1)
    }
}

#[interrupt]
fn irq_keyboard(frame: &Frame) {
    kbd_irqs += 1
    let c = kbd_translate(ps2_read_data())
    if c != 0 {
        kbd_push(c)
    }
    pic_eoi(1)
}

fn kbd_push(c: u8) {
    let next = (kbd_head + 1) % 64
    if next == kbd_tail {
        kbd_dropped += 1
        return
    }
    kbd_buf[kbd_head] = c
    kbd_head = next
}

fn kbd_try_read() -> i32 {
    if kbd_tail == kbd_head {
        return -1
    }
    let c = kbd_buf[kbd_tail]
    kbd_tail = (kbd_tail + 1) % 64
    return c as i32
}

fn kbd_pending() -> usize {
    return (kbd_head + 64 - kbd_tail) % 64
}

fn kbd_dropped_count() -> u64 {
    return kbd_dropped
}

fn kbd_irq_count() -> u64 {
    return kbd_irqs
}

fn kbd_has_ps2() -> bool {
    return kbd_ps2
}

fn is_letter(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn kbd_translate(sc: u8) -> u8 {
    if sc == 0xE0 {
        kbd_extended = true
        return 0
    }
    let extended = kbd_extended
    kbd_extended = false
    let release = sc & 0x80 != 0
    let code = sc & 0x7F

    if code == 0x2A || code == 0x36 {
        if extended {
            return 0
        }
        let mut bit: u8 = 2
        if code == 0x2A {
            bit = 1
        }
        if release {
            kbd_shift &= ~bit
        } else {
            kbd_shift |= bit
        }
        return 0
    }
    if code == 0x1D {
        kbd_ctrl = !release
        return 0
    }
    if release {
        return 0
    }
    if code == 0x3A {
        kbd_caps = !kbd_caps
        return 0
    }
    if extended {
        if code == 0x1C {
            return KEY_ENTER
        }
        if code == 0x35 {
            return '/'
        }
        return 0
    }
    if code as usize >= KEYMAP.len() {
        return 0
    }

    let mut c = KEYMAP[code as usize]
    if kbd_shift != 0 {
        c = KEYMAP_SHIFT[code as usize]
    }
    if kbd_caps && is_letter(c) {
        c ^= 0x20
    }
    if kbd_ctrl && is_letter(c) {
        c = (c | 0x20) - 'a' + 1
    }
    return c
}

fn read_key() -> u8 {
    loop {
        cli()
        let k = kbd_try_read()
        if k >= 0 {
            // I hope I never forget sti again
            sti()
            return k as u8
        }
        let s = serial_poll()
        if s >= 0 {
            sti()
            let c = s as u8
            if c == '\n' {
                return KEY_ENTER
            }
            if c == 127 {
                return KEY_BACKSPACE
            }
            return c
        }
        sti()
        hlt()
    }
}
