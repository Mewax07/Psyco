/// Wiki Doc sources:
///   - https://wiki.osdev.org/System_Calls
///   - https://wiki.osdev.org/Getting_to_Ring_3

import "sched.psy"
import "usermode.psy"
import "console.psy"
import "fat32.psy"
import "heap.psy"
import "psycalls.psy"
import "umem.psy"

const sys_write: u64 = 1
const sys_nanosleep: u64 = 35
const sys_sched_yield: u64 = 24
const sys_getpid: u64 = 39
const sys_exit: u64 = 60
const sys_exit_group: u64 = 231
const nr_mmap: u64 = 9
const nr_munmap: u64 = 11
const nr_brk: u64 = 12

const fd_stdout: u64 = 1
const fd_stderr: u64 = 2

const max_program_size: u64 = 0x400000
const read_chunk: u64 = 32768
const nanos_per_ms: u64 = 1000000
const max_sleep_ms: u64 = 3600000

static mut chunk: [u8; 32768]

#[getter]
static mut syscall_count: u64 = 0

#[syscall]
fn syscall_entry(regs: &mut SyscallRegs) {
    syscall_count += 1
    if regs.rax >= abi::first_call {
        regs.rax = psy_dispatch(regs.rax, regs.rdi, regs.rsi, regs.rdx, regs.r10, regs.r8, regs.r9) as u64
    } else {
        regs.rax = dispatch(regs.rax, regs.rdi, regs.rsi, regs.rdx, regs.r10) as u64
    }
}

fn dispatch(n: u64, a1: u64, a2: u64, a3: u64, a4: u64) -> i64 {
    match n {
        sys_write => {
            if a1 != fd_stdout && a1 != fd_stderr {
                return -abi::err_badf
            }
            return console_write(a2, a3)
        }
        sys_getpid => return current_task_id() as i64,
        sys_sched_yield => {
            yield_now()
            return 0
        }
        sys_nanosleep => return sys_nanosleep_impl(a1),
        nr_brk => return sys_brk(a1),
        nr_mmap => return sys_mmap(a2, a3, a4),
        nr_munmap => return sys_munmap(a1, a2),
        sys_exit | sys_exit_group => {
            task_exit_code(a1 as i64)
            return 0
        }
        _ => return -abi::err_nosys,
    }
}

fn sys_nanosleep_impl(req: u64) -> i64 {
    let mut raw = [0u8; 16]
    if !copy_from_user(&mut raw, req) {
        return -abi::err_fault
    }
    let mut sec: u64 = 0
    let mut nsec: u64 = 0
    for i in 0..8usize {
        sec |= (raw[i] as u64) << (8 * i as u64)
        nsec |= (raw[8 + i] as u64) << (8 * i as u64)
    }
    if nsec >= 1000000000 || sec > max_sleep_ms / 1000 {
        return -abi::err_inval
    }
    task_sleep(sec * 1000 + nsec / nanos_per_ms)
    return 0
}

fn process_init() {
    if gdt_address() < kernel_virt_base || idt_address() < kernel_virt_base {
        panic("process_init: GDT/IDT must be reloaded in the higher half first")
    }
    syscall_init(syscall_entry as u64)
}

fn process_spawn(name: Str, elf: Str) -> i64 {
    let root = as_create()
    let program = load_program(root, elf)
    return process_start(name, root, program)
}

fn process_start(name: Str, root: u64, loaded: Option<LoadedProgram>) -> i64 {
    let Some(program) = loaded else {
        as_destroy(root)
        return -1
    }
    let slot = spawn_user(name, root, program.entry, program.stack_top)
    if slot < 0 {
        as_destroy(root)
    } else {
        umem_init(slot as usize, program.image_end)
        surface_init(slot as usize)
    }
    return slot
}

fn fat_read_buf(e: &DirEntry, buf: &mut Vec<u8>) -> u64 {
    let mut done: u64 = 0
    while done < e.size {
        let mut n = e.size - done
        if n > read_chunk {
            n = read_chunk
        }
        let got = fat_read(e, done, &mut chunk[..n as usize])
        if got == 0 {
            return done
        }
        buf.copy_from(done as usize, &chunk[..got as usize])
        done += got
    }
    return done
}

fn process_spawn_file(path: &[u8]) -> i64 {
    let Some(e) = fat_lookup(path) else {
        return -1
    }
    if is_dir(&e) || e.size == 0 || e.size > max_program_size {
        return -1
    }
    let mut file: Vec<u8> = Vec::zeroed(e.size as usize)
    let got = fat_read_buf(&e, &mut file)
    if got != e.size {
        file.free()
        return -1
    }
    let image = ElfImage {
        data: file.as_slice().as_ptr(),
        size: e.size,
    }
    let root = as_create()
    let program = load_image(root, &image)
    file.free()
    let slot = process_start("", root, program)
    if slot >= 0 {
        let start = last_slash(path) + 1
        task_set_name_bytes(slot as usize, &path[start..])
    }
    return slot
}

fn process_run(name: Str, elf: Str) -> i64 {
    let slot = process_spawn(name, elf)
    if slot < 0 {
        return -1
    }
    return task_wait(slot as usize, task_id(slot as usize))
}
