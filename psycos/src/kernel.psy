const line_max: usize = 76
const bytes_per_kib: u64 = 1024
const bytes_per_mib: u64 = 1048576
const page_bytes: u64 = 4096

const spinner_size: usize = 16
const spinner_gap: usize = 24
const spinner_frame_ms: u64 = 60

const crash_unmapped: u64 = 0xFFFFC00000000000
const crash_non_canonical: u64 = 0x8000000000000000
const page_fault_vector: usize = 14

const path_max: usize = 64
const cat_chunk: usize = 512

static mut cat_buf: [u8; 512]
static mut line: [u8; 76]
static mut line_len: usize = 0
static mut has_fb: bool = false
static mut reclaimed_pages: u64 = 0

fn banner() {
    set_color(cyan)
    puts(" ____                  ___  ____  \n")
    puts("|  _ \\ ___ _   _  ___ / _ \\/ ___| \n")
    puts("| |_) / __| | | |/ __| | | \\___ \\ \n")
    puts("|  __/\\__ \\ |_| | (__| |_| |___) |\n")
    puts("|_|   |___/\\__, |\\___|\\___/|____/ \n")
    puts("           |___/           v0.1\n\n")
    set_color(gray)
    puts("Type 'help' for the list of commands.\n\n")
}

fn prompt() {
    set_color(green)
    puts("psycos> ")
    set_color(white)
}

fn line_is(cmd: Str) -> bool {
    return bytes_equal(&line[..line_len], cmd.as_bytes())
}

fn line_starts_with(prefix: Str) -> bool {
    return bytes_start_with(&line[..line_len], prefix.as_bytes())
}

fn put2(n: u64) {
    if n < 10 {
        putc('0')
    }
    put_u64(n)
}

fn cmd_help() {
    set_color(yellow)
    puts("Commands:\n")
    set_color(gray)
    puts("  help       this help\n")
    puts("  clear      clear the screen\n")
    puts("  ver        version and firmware\n")
    puts("  time       date and time\n")
    puts("  mem        free memory\n")
    puts("  uptime     time since boot\n")
    puts("  ps         list tasks\n")
    puts("  spin       start a demo task (animated square, top right)\n")
    puts("  kill N     stop the task in slot N\n")
    puts("  progs      list the user programs\n")
    puts("  lspci      list PCI devices\n")
    puts("  mouse      pointer position, buttons and devices\n")
    puts("  disks      disks, sector sizes and partitions\n")
    puts("  usb        USB controller (xHCI) and devices\n")
    puts("  log [save] boot log (save: write it to /psyos.log)\n")
    puts("  audio      sound card (Intel HD Audio)\n")
    puts("  beep [H M] play a tone of H Hz for M ms (default 480 Hz, 500 ms)\n")
    puts("  acpi       ACPI tables and power management\n")
    puts("  cpus       processors and interrupt controllers (ACPI MADT)\n")
    puts("  irq        interrupt controller, timers, measured timer rate\n")
    puts("  ls [DIR]   list a directory of the disk (default /)\n")
    puts("  cat FILE   print a file\n")
    puts("  write F T  write the text T into file F (created or replaced)\n")
    puts("  mkdir DIR  create a directory\n")
    puts("  rm PATH    delete a file or an empty directory\n")
    puts("  df         disk usage\n")
    puts("  run P      run a user program (ring 3): /path, /bin/P or built-in\n")
    puts("  start P    same, in the background\n")
    puts("  gui        start the window server and a terminal\n")
    puts("  fb         framebuffer info and test pattern\n")
    puts("  echo TXT   print TXT\n")
    puts("  int3       trigger a breakpoint (execution resumes)\n")
    puts("  crash X    trigger an exception: pf, gp, ud, df\n")
    puts("  reboot     restart the machine\n")
    puts("  shutdown   power off the machine\n")
}

fn cmd_time() {
    let t = now()
    put_u64(t.year as u64)
    putc('-')
    put2(t.month as u64)
    putc('-')
    put2(t.day as u64)
    putc(' ')
    put2(t.hour as u64)
    putc(':')
    put2(t.minute as u64)
    putc(':')
    put2(t.second as u64)
    putc('\n')
}

fn cmd_ver() {
    puts("PsycOS 0.1, written in psy\nFirmware: ")
    let mut vendor = [0u8; 64]
    let n = firmware_vendor(&mut vendor)
    for i in 0..n {
        putc(vendor[i])
    }
    let rev = uefi_revision()
    puts(" (UEFI ")
    put_u64((rev >> 16) as u64)
    putc('.')
    put_u64(((rev & 0xFFFF) / 10) as u64)
    puts(")\n")
    if has_fb {
        puts("Screen: ")
        put_u64(get_fb_width() as u64)
        putc('x')
        put_u64(get_fb_height() as u64)
        puts(", console ")
        put_u64(get_con_cols() as u64)
        putc('x')
        put_u64(get_con_rows() as u64)
        putc('\n')
    }
    puts("Boot services: ")
    if get_boot_services_done() {
        puts("exited\n")
    } else {
        puts("active\n")
    }
    puts("Segments: cs=0x")
    put_hex_width(read_cs() as u64, 2)
    puts(" ds=0x")
    put_hex_width(read_ds() as u64, 2)
    puts(" ss=0x")
    put_hex_width(read_ss() as u64, 2)
    puts(" tr=0x")
    put_hex_width(read_tr() as u64, 2)
    putc('\n')
    puts("Paging: kernel at 0x")
    put_hex(kernel_virt_base)
    puts(", identity + direct map ")
    put_u64(get_identity_limit() / bytes_per_mib / bytes_per_kib)
    puts(" GiB, ")
    put_u64(get_table_pages())
    puts(" table pages\n")
    puts("Disks: ")
    if disk::get_device_count() == 0 {
        puts("none (QEMU: -drive file=disk.img,if=virtio,format=raw)")
    }
    for d in 0..disk::get_device_count() {
        let k = disk::info(d)
        if d > 0 {
            puts(", ")
        }
        puts(disk::kind_name(k.kind))
        putc(' ')
        put_u64(disk::units(d) * 512 / bytes_per_mib)
        puts(" MiB")
    }
    putc('\n')
    puts("File system: ")
    if get_fat_mounted() {
        puts("FAT32 '")
        let label = get_fat_label()
        for i in 0..11usize {
            putc(label[i])
        }
        puts("', ")
        put_u64(get_fat_free_clusters() * get_fat_cluster_bytes() / bytes_per_mib)
        puts(" MiB free")
        if get_fat_partition_start() != 0 {
            puts(" (MBR partition)")
        }
        putc('\n')
    } else {
        puts("none\n")
    }
    puts("Keyboard: ")
    if get_kbd_ps2() {
        puts("PS/2 + serial\n")
    } else {
        puts("serial only\n")
    }
}

fn cmd_mem() {
    let free = get_pmm_free_pages()
    let total = get_pmm_total_pages()
    puts("Physical: ")
    put_u64(free * page_bytes / bytes_per_mib)
    puts(" MiB free of ")
    put_u64(total * page_bytes / bytes_per_mib)
    puts(" MiB (")
    put_u64(free)
    puts(" / ")
    put_u64(total)
    puts(" pages, ")
    put_u64(memory_map_entries() as u64)
    puts(" map entries)\n")
    puts("  incl. ")
    put_u64(reclaimed_pages * page_bytes / bytes_per_mib)
    puts(" MiB reclaimed from the firmware boot services\n")
    if get_pmm_ignored_pages() > 0 {
        puts("  ")
        put_u64(get_pmm_ignored_pages())
        puts(" pages above 16 GiB are not tracked yet\n")
    }
    puts("Heap: ")
    put_u64(get_heap_used_bytes())
    puts(" bytes in ")
    put_u64(get_heap_allocations())
    puts(" blocks, ")
    put_u64(heap_mapped_bytes() / bytes_per_kib)
    puts(" KiB mapped at 0x")
    put_hex(heap_base)
    putc('\n')
    puts("Surfaces: ")
    put_u64(surfaces_in_use() as u64)
    puts(", ports: ")
    put_u64(ports_in_use() as u64)
    putc('\n')
    puts("Kernel stack: ")
    put_u64(kstack_used() as u64)
    puts(" bytes used of ")
    put_u64(kstack_size as u64 / bytes_per_kib)
    puts(" KiB, at 0x")
    put_hex(kstack_bottom() as u64)
    putc('\n')
}

fn cmd_fb() {
    if !has_fb {
        puts("no linear framebuffer\n")
        return
    }
    let w = get_fb_width()
    let h = get_fb_height()
    put_u64(w as u64)
    putc('x')
    put_u64(h as u64)
    puts(" at 0x")
    put_hex(get_fb_base() as u64)
    puts(", ")
    put_u64(get_fb_size() as u64 / bytes_per_kib)
    puts(" KiB\n")
    puts("modes:")
    for i in 0..get_mode_count() {
        let m = video_mode(i)
        putc(' ')
        if i == get_mode_current() {
            putc('*')
        }
        put_u64(m.width as u64)
        putc('x')
        put_u64(m.height as u64)
    }
    putc('\n')

    let colors = [0xFFFFFFu32, 0xFFFF00u32, 0x00FFFFu32, 0x00FF00u32, 0xFF00FFu32, 0xFF0000u32, 0x0000FFu32, 0x000000u32]
    let bar = w / 8
    let top = h - h / 4
    for i in 0..colors.len() {
        fill_rect(i * bar, top, bar, h / 4, colors[i])
    }
    for x in 0..w {
        let v = (x * 255 / w) as u32
        fill_rect(x, h - 16, 1, 16, (v << 16) | (v << 8) | v)
    }
}

fn cmd_uptime() {
    let ms = uptime_ms()
    let s = ms / 1000
    put_u64(s / 3600)
    putc(':')
    put2(s / 60 % 60)
    putc(':')
    put2(s % 60)
    putc('.')
    put2(ms % 1000 / 10)
    puts("  (")
    put_u64(get_ticks())
    puts(" ticks at ")
    put_u64(timer_hz)
    puts(" Hz)\n")
}

fn put_padded(s: Str, width: usize) {
    puts(s)
    for i in s.len()..width {
        putc(' ')
    }
}

fn put_u64_padded(n: u64, width: usize) {
    let mut digits: usize = 1
    let mut v = n
    while v >= 10 {
        v /= 10
        digits += 1
    }
    put_u64(n)
    for i in digits..width {
        putc(' ')
    }
}

fn cmd_ps() {
    set_color(yellow)
    puts("SLOT  ID    RING  CPU  STATE     SWITCHES  TICKS     NAME\n")
    set_color(gray)
    let mut name = [0u8; 16]
    for slot in 0..max_tasks {
        let state = task_state(slot)
        if state == TaskState::Free {
            continue
        }
        put_u64_padded(slot as u64, 6)
        put_u64_padded(task_id(slot), 6)
        if task_is_user(slot) {
            put_padded("3", 6)
        } else {
            put_padded("0", 6)
        }
        put_u64_padded(task_cpu(slot) as u64, 5)
        put_padded(state_name(state), 10)
        put_u64_padded(task_switches(slot), 10)
        put_u64_padded(task_run_ticks(slot), 10)
        let n = task_name(slot, &mut name)
        for i in 0..n {
            putc(name[i])
        }
        putc('\n')
    }
    puts("context switches: ")
    put_u64(get_context_switches())
    puts(", preemptions: ")
    put_u64(get_preemptions())
    putc('\n')
}

fn spinner_main() {
    let x = get_fb_width() - (get_current() + 1) * spinner_gap
    let colors = [0xFF5555u32, 0xFFFF55u32, 0x55FF55u32, 0x55FFFFu32, 0x5555FFu32, 0xFF55FFu32]
    let mut frame: usize = 0
    loop {
        let size = 4 + frame % 4 * 4
        fill_rect(x, 4, spinner_size, spinner_size, black)
        fill_rect(x + (spinner_size - size) / 2, 4 + (spinner_size - size) / 2, size, size, colors[frame % colors.len()])
        frame += 1
        task_sleep(spinner_frame_ms)
    }
}

fn cmd_spin() {
    if !has_fb {
        puts("no framebuffer\n")
        return
    }
    let slot = spawn("spinner", spinner_main)
    if slot < 0 {
        puts("no free task slot\n")
        return
    }
    puts("spinner started in slot ")
    put_u64(slot as u64)
    putc('\n')
}

fn line_number(start: usize) -> i64 {
    let mut n: i64 = 0
    let mut digits = 0
    for i in start..line_len {
        let c = line[i]
        if c < '0' || c > '9' {
            return -1
        }
        n = n * 10 + (c - '0') as i64
        digits += 1
    }
    if digits == 0 {
        return -1
    }
    return n
}

fn pci_class_name(class: u32) -> Str {
    match class >> 8 {
        0x0100 => return "SCSI / virtio storage",
        0x0101 => return "IDE controller",
        0x0106 => return "SATA controller",
        0x0108 => return "NVMe controller",
        0x0200 => return "Ethernet",
        0x0300 => return "VGA display",
        0x0600 => return "host bridge",
        0x0601 => return "ISA bridge",
        0x0604 => return "PCI bridge",
        0x0C03 => return "USB controller",
        0x0C05 => return "SMBus",
        _ => return "other",
    }
}

fn cmd_lspci() {
    set_color(yellow)
    puts("BUS:DEV.FN  VENDOR:DEVICE  CLASS\n")
    set_color(gray)
    for bus in 0..pci_max_bus {
        for device in 0..pci_max_device {
            if pci_vendor(bus, device, 0) == pci_no_vendor {
                continue
            }
            for function in 0..pci_function_count(bus, device) {
                let vendor = pci_vendor(bus, device, function)
                if vendor == pci_no_vendor {
                    continue
                }
                put_hex_width(bus as u64, 2)
                putc(':')
                put_hex_width(device as u64, 2)
                putc('.')
                put_u64(function as u64)
                puts("     ")
                put_hex_width(vendor as u64, 4)
                putc(':')
                put_hex_width(pci_device_id(bus, device, function) as u64, 4)
                puts("      ")
                puts(pci_class_name(pci_class(bus, device, function)))
                putc('\n')
            }
        }
    }
}

fn cmd_mouse() {
    puts("mouse: ")
    if !mouse_present() {
        puts("no ps2")
    } else if get_mouse_packet_size() == 4 {
        puts("ps2 wheel")
    } else {
        puts("ps2")
    }
    puts(", tablet ")
    if tablet::get_ready() {
        puts("on")
    } else {
        puts("off")
    }
    puts("\npointer: ")
    put_i64(get_mouse_x())
    putc(' ')
    put_i64(get_mouse_y())
    puts(" buttons ")
    put_u64(get_mouse_buttons())
    puts(" wheel ")
    put_i64(get_mouse_wheel())
    puts("\npackets: ")
    put_u64(get_mouse_packets())
    puts(", resyncs ")
    put_u64(get_mouse_resyncs())
    puts(", overflows ")
    put_u64(get_mouse_overflows())
    puts(", tablet events ")
    put_u64(tablet::get_events())
    puts(", routed ")
    put_u64(get_pointer_routed())
    puts(", dropped ")
    put_u64(get_pointer_dropped())
    putc('\n')
}

fn put_signature(sig: u32) {
    for i in 0..4u32 {
        putc((sig >> (i * 8)) as u8)
    }
}

fn cmd_acpi() {
    if !acpi::get_ready() {
        puts("acpi: no tables\n")
        return
    }
    puts("acpi: revision ")
    put_u64(acpi::get_revision() as u64)
    puts(", ")
    put_u64(acpi::get_table_count() as u64)
    puts(" tables\n")
    for i in 0..acpi::get_table_count() {
        let t = acpi::table_info(i)
        puts("  ")
        put_signature(t.signature)
        puts("  rev ")
        put_u64(t.revision as u64)
        puts("  ")
        put_u64(t.length as u64)
        puts(" bytes at ")
        put_hex(t.address)
        putc('\n')
    }
    puts("power off: ")
    if acpi::get_s5_found() {
        puts("S5 type ")
        put_u64(acpi::get_sleep_type_a() as u64)
    } else {
        puts("no _S5")
    }
    puts(", reset register ")
    if acpi::get_reset_supported() {
        puts("yes")
    } else {
        puts("no")
    }
    puts(", SCI irq ")
    put_u64(acpi::get_sci_irq() as u64)
    putc('\n')
}

fn cmd_cpus() {
    puts("cpus: ")
    put_u64(acpi::get_cpu_count() as u64)
    puts(" (APIC ids")
    for i in 0..acpi::get_cpu_count() {
        putc(' ')
        put_u64(acpi::cpu_apic_id(i) as u64)
    }
    puts(")\nonline: ")
    put_u64(get_cpus_online() as u64)
    puts(", user tasks in parallel (max): ")
    put_u64(get_max_parallel_user())
    puts(", kernel lock waits: ")
    put_u64(get_lock_spins())
    for c in 0..get_cpus_online() {
        puts("\n  cpu ")
        put_u64(c as u64)
        puts(": APIC id ")
        put_u64(cpu_apic(c) as u64)
        puts(", busy ")
        put_u64(cpu_busy_ticks(c))
        puts(" ticks")
    }
    puts("\nlocal APIC at ")
    put_hex(acpi::get_lapic_address())
    if acpi::get_legacy_pics() {
        puts(", 8259 PICs present")
    }
    putc('\n')
    for i in 0..acpi::get_ioapic_count() {
        let io = acpi::ioapic(i)
        puts("IOAPIC ")
        put_u64(io.id as u64)
        puts(" at ")
        put_hex(io.address)
        puts(", GSI base ")
        put_u64(io.gsi_base as u64)
        putc('\n')
    }
    for i in 0..acpi::get_override_count() {
        let o = acpi::irq_override(i)
        puts("override: irq ")
        put_u64(o.irq as u64)
        puts(" -> GSI ")
        put_u64(o.gsi as u64)
        puts(" flags ")
        put_u64(o.flags as u64)
        putc('\n')
    }
}

fn cmd_irq() {
    puts("interrupts: ")
    if get_apic_on() {
        puts("APIC (local APIC timer, IOAPIC)\n")
        puts("local APIC timer: ")
        put_u64(get_lapic_ticks_10ms())
        puts(" ticks per 10 ms (divide 16)\n")
    } else {
        puts("8259 PIC + PIT\n")
    }
    puts("HPET: ")
    if !get_hpet_on() {
        puts("off\n")
        return
    }
    put_u64(1000000000 / get_hpet_period_fs())
    puts(" MHz\n")
    let start = get_ticks()
    hpet_wait_ms(500)
    let hz = (get_ticks() - start) * 2
    puts("timer rate: ")
    put_u64(hz)
    puts(" Hz")
    if hz >= 90 && hz <= 110 {
        puts(" (ok)")
    }
    puts(", spurious ")
    put_u64(get_spurious_count())
    putc('\n')
}

fn cmd_disks() {
    for d in 0..disk::get_device_count() {
        let k = disk::info(d)
        puts("disk ")
        put_u64(d as u64)
        puts(": ")
        puts(disk::kind_name(k.kind))
        puts(", ")
        put_u64(k.sectors)
        puts(" sectors of ")
        put_u64(k.sector_size)
        puts(" bytes (")
        put_u64(disk::units(d) * 512 / bytes_per_mib)
        puts(" MiB)\n")
    }
    for i in 0..disk::get_part_count() {
        let p = disk::partition(i)
        if p.scheme == disk::scheme_whole {
            continue
        }
        puts("  partition: disk ")
        put_u64(p.disk as u64)
        if p.scheme == disk::scheme_gpt {
            puts(" gpt")
        } else {
            puts(" mbr")
        }
        puts(" start ")
        put_u64(p.start)
        puts(" size ")
        put_u64(p.units * 512 / bytes_per_mib)
        puts(" MiB")
        if p.esp {
            puts(" (EFI system)")
        }
        putc('\n')
    }
    if get_fat_mounted() {
        puts("mounted: disk ")
        put_u64(get_fat_disk() as u64)
        puts(", FAT32 with ")
        put_u64(get_sector_bytes())
        puts("-byte sectors\n")
    } else {
        puts("mounted: none\n")
    }
}

fn cmd_usb() {
    if !get_usb_ready() {
        puts("usb: no xHCI controller\n")
        return
    }
    puts("usb: xHCI, ")
    put_u64(xhci::get_port_count())
    puts(" ports, ")
    put_u64(xhci::get_device_count() as u64)
    puts(" devices\n")
    for d in 0..xhci::get_device_count() {
        let dev = xhci::device_info(d)
        puts("  port ")
        put_u64(dev.port)
        puts(": ")
        puts(usb_kind_name(dev.kind))
        puts(" (")
        put_hex_width(dev.vendor, 4)
        putc(':')
        put_hex_width(dev.product, 4)
        puts("), slot ")
        put_u64(dev.slot)
        puts(", reports ")
        if dev.reports > 0 {
            puts("yes")
        } else {
            puts("no")
        }
        putc('\n')
    }
    puts("errors: ")
    put_u64(xhci::get_errors())
    putc('\n')
}

fn cmd_shutdown() {
    if acpi::get_s5_found() {
        print("[acpi] power off (S5)")
        acpi::power_off()
    }
    shutdown()
}

fn cmd_reboot() {
    if acpi::get_reset_supported() {
        print("[acpi] reset")
        acpi::reset()
    }
    reboot()
}

fn cmd_progs() {
    set_color(yellow)
    puts("User programs (ring 3, psycoc Linux executables):\n")
    set_color(gray)
    for i in 0..program_count {
        puts("  ")
        put_padded(program_name(i), 12)
        put_u64(program_elf(i).len() as u64)
        puts(" bytes\n")
    }
}

fn line_word(start: usize, buf: &mut [u8]) -> usize {
    let mut n: usize = 0
    let mut i = start
    while i < line_len && line[i] != ' ' && n < buf.len() {
        buf[n] = line[i]
        n += 1
        i += 1
    }
    return n
}

fn find_program(name: &[u8]) -> Option<usize> {
    for i in 0..program_count {
        if bytes_equal(program_name(i).as_bytes(), name) {
            return Some(i)
        }
    }
    return None
}

fn start_program(name: &[u8], len: usize) -> i64 {
    if len == 0 {
        return -1
    }
    if name[0] == '/' {
        return process_spawn_file(&name[..len])
    }
    if get_fat_mounted() && len + 5 <= 64 {
        let mut path = [0u8; 64]
        let prefix = "/bin/".as_bytes()
        for i in 0..prefix.len() {
            path[i] = prefix[i]
        }
        for i in 0..len {
            path[5 + i] = name[i]
        }
        let slot = process_spawn_file(&path[..len + 5])
        if slot >= 0 {
            return slot
        }
    }
    let Some(i) = find_program(&name[..len]) else {
        return -1
    }
    return process_spawn(program_name(i), program_elf(i))
}

fn cmd_run(start: usize, wait: bool) {
    let mut name = [0u8; 64]
    let len = line_word(start, &mut name)
    let slot = start_program(&name, len)
    if slot < 0 {
        puts("no such program (see progs and ls /bin)\n")
        return
    }
    let s = slot as usize
    if !wait {
        let was_on = irq_save()
        puts("started in slot ")
        put_u64(s as u64)
        putc('\n')
        irq_restore(was_on)
        return
    }
    let code = task_wait(s, task_id(s))
    set_color(dark_gray)
    puts("exit code ")
    put_i64(code)
    putc('\n')
    set_color(white)
}

fn cmd_gui() {
    let server = process_spawn_file("/bin/windowserver".as_bytes())
    if server < 0 {
        puts("gui: /bin/windowserver not found\n")
        return
    }
    let term = process_spawn_file("/bin/terminal".as_bytes())
    if term < 0 {
        task_kill(server as usize)
        puts("gui: /bin/terminal not found\n")
        return
    }
    let was_on = irq_save()
    puts("gui: window server in slot ")
    put_u64(server as u64)
    puts(", terminal in slot ")
    put_u64(term as u64)
    putc('\n')
    irq_restore(was_on)
}

fn skip_spaces(start: usize) -> usize {
    let mut i = start
    while i < line_len && line[i] == ' ' {
        i += 1
    }
    return i
}

fn need_disk() -> bool {
    if get_fat_mounted() {
        return true
    }
    puts("no FAT32 disk (QEMU: -drive file=disk.img,if=virtio,format=raw)\n")
    return false
}

fn put_u64_right(n: u64, width: usize) {
    let mut digits: usize = 1
    let mut v = n
    while v >= 10 {
        v /= 10
        digits += 1
    }
    for i in digits..width {
        putc(' ')
    }
    put_u64(n)
}

fn cmd_ls(start: usize) {
    if !need_disk() {
        return
    }
    let mut path = [0u8; 64]
    let mut len = line_word(skip_spaces(start), &mut path)
    if len == 0 {
        path[0] = '/'
        len = 1
    }
    let Some(d) = fat_lookup(&path[..len]) else {
        puts("not found\n")
        return
    }
    if !is_dir(&d) {
        put_u64_right(d.size, 10)
        puts("  ")
        for i in 0..d.name_len {
            putc(d.name[i])
        }
        putc('\n')
        return
    }
    let mut it = dir_open(d.cluster)
    let mut e = blank_entry()
    let mut files: u64 = 0
    let mut bytes: u64 = 0
    while dir_next(&mut it, &mut e) {
        if e.name[0] == '.' && (e.name_len == 1 || (e.name_len == 2 && e.name[1] == '.')) {
            continue
        }
        if is_dir(&e) {
            puts("     <DIR>  ")
            set_color(blue)
        } else {
            put_u64_right(e.size, 10)
            puts("  ")
            files += 1
            bytes += e.size
        }
        for i in 0..e.name_len {
            putc(e.name[i])
        }
        set_color(white)
        putc('\n')
    }
    set_color(dark_gray)
    put_u64(files)
    puts(" files, ")
    put_u64(bytes)
    puts(" bytes\n")
    set_color(white)
}

fn cmd_cat(start: usize) {
    if !need_disk() {
        return
    }
    let mut path = [0u8; 64]
    let len = line_word(skip_spaces(start), &mut path)
    let Some(e) = fat_lookup(&path[..len]) else {
        puts("no such file\n")
        return
    }
    if is_dir(&e) {
        puts("no such file\n")
        return
    }
    let mut offset: u64 = 0
    let mut last: u8 = '\n'
    while offset < e.size {
        let got = fat_read(&e, offset, &mut cat_buf)
        if got == 0 {
            puts("\nread error\n")
            return
        }
        for i in 0..got as usize {
            let c = cat_buf[i]
            if c == '\n' || c == '\t' || (c >= 32 && c < 127) {
                putc(c)
            } else if c != '\r' {
                putc('.')
            }
            last = c
        }
        offset += got
    }
    if last != '\n' {
        putc('\n')
    }
}

fn cmd_write(start: usize) {
    if !need_disk() {
        return
    }
    let mut path = [0u8; 64]
    let first = skip_spaces(start)
    let len = line_word(first, &mut path)
    let text_start = skip_spaces(first + len)
    if len == 0 || text_start >= line_len {
        puts("usage: write /FILE text\n")
        return
    }
    let mut data = [0u8; 77]
    let mut n: usize = 0
    for i in text_start..line_len {
        data[n] = line[i]
        n += 1
    }
    data[n] = '\n'
    if fat_write_file(&path[..len], &data[..n + 1]) {
        puts("written\n")
    } else {
        puts("cannot write (8.3 names only, parent directory must exist)\n")
    }
}

fn cmd_tree(start: usize, make: bool) {
    if !need_disk() {
        return
    }
    let mut path = [0u8; 64]
    let len = line_word(skip_spaces(start), &mut path)
    let mut ok = false
    if make {
        ok = fat_mkdir(&path[..len])
    } else {
        ok = fat_delete(&path[..len])
    }
    if ok {
        puts("done\n")
    } else if make {
        puts("cannot create it (8.3 name, parent must exist, not already there)\n")
    } else {
        puts("cannot delete it (missing, or a directory that is not empty)\n")
    }
}

fn cmd_df() {
    if !need_disk() {
        return
    }
    let cluster = get_fat_cluster_bytes()
    let total = get_fat_total_clusters() * cluster
    let free = get_fat_free_clusters() * cluster
    puts("FAT32: ")
    put_u64((total - free) / bytes_per_kib)
    puts(" KiB used, ")
    put_u64(free / bytes_per_kib)
    puts(" KiB free, ")
    put_u64(cluster)
    puts("-byte clusters\n")
}

fn cmd_kill() {
    let n = line_number(5)
    if n < 0 || n >= max_tasks as i64 {
        puts("usage: kill N (see ps)\n")
        return
    }
    let slot = n as usize
    let mut name = [0u8; 16]
    let len = task_name(slot, &mut name)
    let was_spinner = len == 7 && name[0] == 's' && name[1] == 'p'
    if !task_kill(slot) {
        puts("cannot kill this task\n")
        return
    }
    if was_spinner && has_fb {
        fill_rect(get_fb_width() - (slot + 1) * spinner_gap, 4, spinner_size, spinner_size, black)
    }
    puts("killed\n")
}

fn cmd_crash() {
    if line_is("crash pf") {
        puts("reading 0xFFFFC00000000000...\n")
        let v = debug_read_u64(crash_unmapped)
        put_hex(v)
    } else if line_is("crash gp") {
        puts("reading non-canonical address 0x8000000000000000...\n")
        let v = debug_read_u64(crash_non_canonical)
        put_hex(v)
    } else if line_is("crash ud") {
        ud2()
    } else if line_is("crash df") {
        puts("removing the #PF handler, then faulting...\n")
        idt_clear_gate(page_fault_vector)
        let v = debug_read_u64(crash_unmapped)
        put_hex(v)
    } else {
        puts("usage: crash pf|gp|ud|df\n")
    }
}

fn run_command() {
    if line_len == 0 {
        return
    }
    if line_is("help") {
        cmd_help()
    } else if line_is("clear") {
        clear()
    } else if line_is("ver") {
        cmd_ver()
    } else if line_is("time") {
        cmd_time()
    } else if line_is("mem") {
        cmd_mem()
    } else if line_is("fb") {
        cmd_fb()
    } else if line_starts_with("echo ") {
        for i in 5..line_len {
            putc(line[i])
        }
        putc('\n')
    } else if line_is("uptime") {
        cmd_uptime()
    } else if line_is("ps") {
        cmd_ps()
    } else if line_is("spin") {
        cmd_spin()
    } else if line_starts_with("kill ") {
        cmd_kill()
    } else if line_is("progs") {
        cmd_progs()
    } else if line_is("lspci") {
        cmd_lspci()
    } else if line_is("mouse") {
        cmd_mouse()
    } else if line_is("acpi") {
        cmd_acpi()
    } else if line_is("cpus") {
        cmd_cpus()
    } else if line_is("irq") {
        cmd_irq()
    } else if line_is("disks") {
        cmd_disks()
    } else if line_is("usb") {
        cmd_usb()
    } else if line_is("log") || line_is("log save") {
        cmd_log()
    } else if line_is("audio") {
        cmd_audio()
    } else if line_is("beep") || line_starts_with("beep ") {
        cmd_beep()
    } else if line_is("ls") || line_starts_with("ls ") {
        cmd_ls(2)
    } else if line_starts_with("cat ") {
        cmd_cat(4)
    } else if line_starts_with("write ") {
        cmd_write(6)
    } else if line_starts_with("mkdir ") {
        cmd_tree(6, true)
    } else if line_starts_with("rm ") {
        cmd_tree(3, false)
    } else if line_is("df") {
        cmd_df()
    } else if line_starts_with("run ") {
        cmd_run(4, true)
    } else if line_starts_with("start ") {
        cmd_run(6, false)
    } else if line_is("gui") {
        cmd_gui()
    } else if line_is("int3") {
        int3()
        puts("resumed after int3 (")
        put_u64(get_breakpoints())
        puts(" so far)\n")
    } else if line_starts_with("crash") {
        cmd_crash()
    } else if line_is("reboot") {
        cmd_reboot()
    } else if line_is("shutdown") {
        cmd_shutdown()
    } else {
        set_color(red)
        puts("unknown command: ")
        for i in 0..line_len {
            putc(line[i])
        }
        putc('\n')
        set_color(white)
    }
}

fn read_line() {
    line_len = 0
    loop {
        let c = read_key()
        if c == key_enter {
            putc('\n')
            return
        }
        if c == key_backspace {
            if line_len > 0 {
                line_len -= 1
                putc(key_backspace)
                putc(' ')
                putc(key_backspace)
            }
            continue
        }
        if c >= 32 && c < 127 && line_len < line_max {
            line[line_len] = c
            line_len += 1
            putc(c)
        }
    }
}

fn cpu_init() {
    sse_init()
    gdt_init()
    exceptions_init()
}

fn log_firmware() {
    let mut vendor = [0u8; 40]
    let n = firmware_vendor(&mut vendor)
    log_begin("uefi")
    log_bytes(&vendor[..n])
    log_str(", revision ")
    log_u64((uefi_revision() >> 16) as u64)
    log_put('.')
    log_u64((uefi_revision() & 0xFFFF) as u64 / 10)
    log_end()
    log_begin("video")
    if has_fb {
        log_u64(get_fb_width() as u64)
        log_put('x')
        log_u64(get_fb_height() as u64)
        log_str(" (GOP)")
    } else {
        log_str("no framebuffer")
    }
    log_end()
}

fn log_hardware() {
    log_begin("memory")
    log_u64(get_pmm_free_pages() * page_bytes / bytes_per_mib)
    log_str(" MiB free")
    log_end()
    log_begin("acpi")
    if acpi::get_ready() {
        log_u64(acpi::get_table_count() as u64)
        log_str(" tables, ")
        log_u64(acpi::get_cpu_count() as u64)
        log_str(" cpus")
    } else {
        log_str("not found")
    }
    log_end()
    log_begin("irq")
    if get_apic_on() {
        log_str("local APIC + IOAPIC")
    } else {
        log_str("8259 PIC + PIT")
    }
    if get_hpet_on() {
        log_str(", HPET")
    }
    log_end()
}

fn log_devices() {
    log_begin("disks")
    log_u64(disk::get_device_count() as u64)
    for d in 0..disk::get_device_count() {
        let k = disk::info(d)
        log_put(' ')
        log_str(disk::kind_name(k.kind))
        log_put('/')
        log_u64(k.sector_size)
    }
    log_end()
    log_begin("fs")
    if get_fat_mounted() {
        log_str("FAT32 on disk ")
        log_u64(get_fat_disk() as u64)
        log_str(" (")
        log_str(disk::kind_name(disk::info(get_fat_disk()).kind))
        log_put(')')
    } else {
        log_str("no volume")
    }
    log_end()
    log_begin("input")
    if get_kbd_ps2() {
        log_str("ps2 keyboard")
    } else {
        log_str("no ps2 keyboard")
    }
    if mouse_present() {
        log_str(", ps2 mouse")
    }
    if tablet::get_ready() {
        log_str(", virtio tablet")
    }
    if get_usb_ready() {
        log_str(", usb devices ")
        log_u64(xhci::get_device_count() as u64)
    }
    log_end()
    if hda::get_ready() {
        log_begin("audio")
        log_str("HD Audio codec ")
        log_hex(hda::get_vendor() as u64)
        log_end()
    }
}

fn cmd_audio() {
    if !hda::get_ready() {
        puts("audio: no HD Audio controller with an output\n")
        return
    }
    puts("audio: HD Audio, codec ")
    put_u64(hda::get_codec() as u64)
    puts(" vendor ")
    put_hex_width((hda::get_vendor() >> 16) as u64, 4)
    putc(':')
    put_hex_width((hda::get_vendor() & 0xFFFF) as u64, 4)
    puts(", function group ")
    put_u64(hda::get_afg() as u64)
    puts(", DAC ")
    put_u64(hda::get_dac() as u64)
    puts(" -> pin ")
    put_u64(hda::get_pin() as u64)
    puts(", errors ")
    put_u64(hda::get_errors())
    putc('\n')
}

fn word_number(at: &mut usize) -> Option<u64> {
    while *at < line_len && line[*at] == ' ' {
        *at += 1
    }
    let mut n: u64 = 0
    let mut digits: usize = 0
    while *at < line_len && line[*at] >= '0' && line[*at] <= '9' && digits < 9 {
        n = n * 10 + (line[*at] - '0') as u64
        digits += 1
        *at += 1
    }
    if digits == 0 {
        return None
    }
    return Some(n)
}

fn cmd_beep() {
    let mut hz: u64 = 480
    let mut ms: u64 = 500
    let mut at: usize = 5
    if let Some(v) = word_number(&mut at) {
        hz = v
    }
    if let Some(v) = word_number(&mut at) {
        ms = v
    }
    if !hda::play_tone(hz) {
        puts("beep: no sound output\n")
        return
    }
    let start = hda::position()
    task_sleep(ms)
    let moved = hda::position() != start
    hda::stop()
    puts("beep: ")
    put_u64(hz)
    puts(" Hz, ")
    put_u64(ms)
    puts(" ms, stream moved: ")
    if moved {
        puts("true\n")
    } else {
        puts("false\n")
    }
}

fn cmd_log() {
    if line_is("log save") {
        if !get_fat_mounted() {
            puts("log: no volume mounted\n")
            return
        }
        if fat_write_file("/psyos.log".as_bytes(), log_contents()) {
            puts("log saved to /psyos.log\n")
        } else {
            puts("log: write failed\n")
        }
        return
    }
    log_dump()
    if get_log_lost() > 0 {
        puts("(")
        put_u64(get_log_lost())
        puts(" bytes lost)\n")
    }
}

fn main() {
    efi_init()
    config_load()
    let video = config_video()
    has_fb = fb_init_mode(video.width, video.height)
    con_init(has_fb)
    set_log_echo(config_is("log", "on"))
    log_line("boot", "PsycOS v0.1")
    log_firmware()
    let ram = !config_is("ramdisk", "off") && ramdisk_load()
    log_begin("ramdisk")
    if ram {
        log_str("\\PSYOS.IMG, ")
        log_u64(get_ram_bytes() / bytes_per_mib)
        log_str(" MiB")
    } else {
        log_str("none")
    }
    log_end()

    if !exit_boot_services() {
        panic("ExitBootServices failed")
    }
    cli()
    cpu_init()
    pmm_init()
    paging_init()
    enter_higher_half(kmain)
}

fn kmain() {
    rebase_kernel_statics()
    if (program_name(0) as *const u8 as u64) < kernel_virt_base {
        panic("statics still point to the low half")
    }
    cpu_init()
    log_line("boot", "boot services left, higher half")
    acpi::init()
    reclaimed_pages = pmm_reclaim_boot_services()
    heap_init()
    irq_init()
    if !config_is("apic", "off") {
        irq_use_apic()
    }
    log_hardware()
    sched_init()
    process_init()
    disk::init()
    fat_mount()
    kbd_init()
    mouse_init()
    tablet_init()
    if !config_is("usb", "off") {
        usb_init()
    }
    input_init()
    term_init()
    if !config_is("audio", "off") {
        hda::init()
    }
    log_devices()
    sti()
    let mut cores: usize = 1
    if !config_is("smp", "off") {
        cores = smp_init()
    }
    if cores > 1 {
        puts("[smp] ")
        put_u64(cores as u64)
        puts(" processors online\n")
    }
    log_begin("smp")
    log_u64(cores as u64)
    log_str(" cpus online")
    log_end()
    clock_init()
    log_line("boot", "ready")
    print("PsycOS: boot ok")
    banner()
    if config_is("gui", "on") {
        cmd_gui()
    }
    loop {
        prompt()
        read_line()
        run_command()
    }
}
