/// Wiki Doc sources:
///   - https://wiki.osdev.org/UEFI
///   - https://wiki.osdev.org/Interrupts
///   - https://wiki.osdev.org/X86_Interrupts#From_the_CPU's_perspective
///
/// Kernel entry point and shell.
/// Boot (firmware tables, low addresses): efi_init -> fb_init -> con_init ->
/// exit_boot_services -> cli -> cpu_init -> pmm_init -> paging_init ->
/// enter_higher_half(kmain).
/// kmain (our tables, higher half, kernel stack): cpu_init again ->
/// reclaim boot services memory -> irq_init -> kbd_init -> sti -> shell.

import "efi.psy"
import "fb.psy"
import "console.psy"
import "keyboard.psy"
import "stack.psy"
import "gdt.psy"
import "exceptions.psy"
import "debug.psy"
import "timer.psy"
import "pmm.psy"
import "paging.psy"

const line_max: usize = 76
const bytes_per_kib: u64 = 1024
const bytes_per_mib: u64 = 1048576
const page_bytes: u64 = 4096

// Addresses used by `crash`: unmapped and non-canonical.
const crash_unmapped: u64 = 0xFFFFC00000000000
const crash_non_canonical: u64 = 0x8000000000000000
const page_fault_vector: usize = 14

static mut line: [u8; 76]
static mut line_len: usize = 0
static mut has_fb: bool = false
static mut reclaimed_pages: u64 = 0

/// Logo and welcome text.
fn banner() {
    set_color(cyan)
    puts(" ____                  ___  ____  \n")
    puts("|  _ \\ ___ _   _  ___ / _ \\/ ___| \n")
    puts("| |_) / __| | | |/ __| | | \\___ \\ \n")
    puts("|  __/\\__ \\ |_| | (__| |_| |___) |\n")
    puts("|_|   |___/\\__, |\\___|\\___/|____/ \n")
    puts("           |___/           v0.1\n\n")
    set_color(gray)
    puts("Type 'help' for the list of commands.\n\n")
}

/// Shell prompt.
fn prompt() {
    set_color(green)
    puts("psycos> ")
    set_color(white)
}

/// True if the typed line is exactly `cmd`.
fn line_is(cmd: Str) -> bool {
    if line_len != cmd.len() {
        return false
    }
    for i in 0..line_len {
        if line[i] != str_byte(cmd, i) {
            return false
        }
    }
    return true
}

/// True if the typed line starts with `prefix`.
fn line_starts_with(prefix: Str) -> bool {
    if line_len < prefix.len() {
        return false
    }
    for i in 0..prefix.len() {
        if line[i] != str_byte(prefix, i) {
            return false
        }
    }
    return true
}

/// Prints a number on at least two digits.
fn put2(n: u64) {
    if n < 10 {
        putc('0')
    }
    put_u64(n)
}

/// `help`: list of commands.
fn cmd_help() {
    set_color(yellow)
    puts("Commands:\n")
    set_color(gray)
    puts("  help       this help\n")
    puts("  clear      clear the screen\n")
    puts("  ver        version and firmware\n")
    puts("  time       date and time\n")
    puts("  mem        free memory\n")
    puts("  uptime     time since boot\n")
    puts("  fb         framebuffer info and test pattern\n")
    puts("  echo TXT   print TXT\n")
    puts("  int3       trigger a breakpoint (execution resumes)\n")
    puts("  crash X    trigger an exception: pf, gp, ud, df\n")
    puts("  reboot     restart the machine\n")
    puts("  shutdown   power off the machine\n")
}

/// `time`: date and time from the firmware clock.
fn cmd_time() {
    let t = now()
    put_u64(t.year as u64)
    putc('-')
    put2(t.month as u64)
    putc('-')
    put2(t.day as u64)
    putc(' ')
    put2(t.hour as u64)
    putc(':')
    put2(t.minute as u64)
    putc(':')
    put2(t.second as u64)
    putc('\n')
}

/// `ver`: version, firmware, screen and CPU state.
fn cmd_ver() {
    puts("PsycOS 0.1, written in psy\nFirmware: ")
    let mut vendor = [0u8; 64]
    let n = firmware_vendor(&mut vendor)
    for i in 0..n {
        putc(vendor[i])
    }
    let rev = uefi_revision()
    puts(" (UEFI ")
    put_u64((rev >> 16) as u64)
    putc('.')
    put_u64(((rev & 0xFFFF) / 10) as u64)
    puts(")\n")
    if has_fb {
        puts("Screen: ")
        put_u64(get_fb_width() as u64)
        putc('x')
        put_u64(get_fb_height() as u64)
        puts(", console ")
        put_u64(get_con_cols() as u64)
        putc('x')
        put_u64(get_con_rows() as u64)
        putc('\n')
    }
    puts("Boot services: ")
    if get_boot_services_done() {
        puts("exited\n")
    } else {
        puts("active\n")
    }
    puts("Segments: cs=0x")
    put_hex_width(read_cs() as u64, 2)
    puts(" ds=0x")
    put_hex_width(read_ds() as u64, 2)
    puts(" ss=0x")
    put_hex_width(read_ss() as u64, 2)
    puts(" tr=0x")
    put_hex_width(read_tr() as u64, 2)
    putc('\n')
    puts("Paging: kernel at 0x")
    put_hex(kernel_virt_base)
    puts(", identity + direct map ")
    put_u64(get_identity_limit() / bytes_per_mib / bytes_per_kib)
    puts(" GiB, ")
    put_u64(get_table_pages())
    puts(" table pages\n")
    puts("Keyboard: ")
    if get_kbd_ps2() {
        puts("PS/2 + serial\n")
    } else {
        puts("serial only\n")
    }
}

/// `mem`: physical allocator and kernel stack use.
fn cmd_mem() {
    let free = get_pmm_free_pages()
    let total = get_pmm_total_pages()
    puts("Physical: ")
    put_u64(free * page_bytes / bytes_per_mib)
    puts(" MiB free of ")
    put_u64(total * page_bytes / bytes_per_mib)
    puts(" MiB (")
    put_u64(free)
    puts(" / ")
    put_u64(total)
    puts(" pages, ")
    put_u64(memory_map_entries() as u64)
    puts(" map entries)\n")
    puts("  incl. ")
    put_u64(reclaimed_pages * page_bytes / bytes_per_mib)
    puts(" MiB reclaimed from the firmware boot services\n")
    if get_pmm_ignored_pages() > 0 {
        puts("  ")
        put_u64(get_pmm_ignored_pages())
        puts(" pages above 16 GiB are not tracked yet\n")
    }
    puts("Kernel stack: ")
    put_u64(kstack_used() as u64)
    puts(" bytes used of ")
    put_u64(kstack_size as u64 / bytes_per_kib)
    puts(" KiB, at 0x")
    put_hex(kstack_bottom() as u64)
    putc('\n')
}

/// `fb`: framebuffer info, color bars and a gray ramp.
fn cmd_fb() {
    if !has_fb {
        puts("no linear framebuffer\n")
        return
    }
    let w = get_fb_width()
    let h = get_fb_height()
    put_u64(w as u64)
    putc('x')
    put_u64(h as u64)
    puts(" at 0x")
    put_hex(get_fb_base() as u64)
    puts(", ")
    put_u64(get_fb_size() as u64 / bytes_per_kib)
    puts(" KiB\n")

    let colors = [0xFFFFFFu32, 0xFFFF00u32, 0x00FFFFu32, 0x00FF00u32, 0xFF00FFu32, 0xFF0000u32, 0x0000FFu32, 0x000000u32]
    let bar = w / 8
    let top = h - h / 4
    for i in 0..colors.len() {
        fill_rect(i * bar, top, bar, h / 4, colors[i])
    }
    for x in 0..w {
        let v = (x * 255 / w) as u32
        fill_rect(x, h - 16, 1, 16, (v << 16) | (v << 8) | v)
    }
}

/// `uptime`: time since the timer started.
fn cmd_uptime() {
    let ms = uptime_ms()
    let s = ms / 1000
    put_u64(s / 3600)
    putc(':')
    put2(s / 60 % 60)
    putc(':')
    put2(s % 60)
    putc('.')
    put2(ms % 1000 / 10)
    puts("  (")
    put_u64(get_ticks())
    puts(" ticks at ")
    put_u64(timer_hz)
    puts(" Hz)\n")
}

/// `crash X`: triggers an exception on purpose.
fn cmd_crash() {
    if line_is("crash pf") {
        puts("reading 0xFFFFC00000000000...\n")
        let v = debug_read_u64(crash_unmapped)
        put_hex(v)
    } else if line_is("crash gp") {
        puts("reading non-canonical address 0x8000000000000000...\n")
        let v = debug_read_u64(crash_non_canonical)
        put_hex(v)
    } else if line_is("crash ud") {
        ud2()
    } else if line_is("crash df") {
        puts("removing the #PF handler, then faulting...\n")
        idt_clear_gate(page_fault_vector)
        let v = debug_read_u64(crash_unmapped)
        put_hex(v)
    } else {
        puts("usage: crash pf|gp|ud|df\n")
    }
}

/// Runs the typed command.
fn run_command() {
    if line_len == 0 {
        return
    }
    if line_is("help") {
        cmd_help()
    } else if line_is("clear") {
        clear()
    } else if line_is("ver") {
        cmd_ver()
    } else if line_is("time") {
        cmd_time()
    } else if line_is("mem") {
        cmd_mem()
    } else if line_is("fb") {
        cmd_fb()
    } else if line_starts_with("echo ") {
        for i in 5..line_len {
            putc(line[i])
        }
        putc('\n')
    } else if line_is("uptime") {
        cmd_uptime()
    } else if line_is("int3") {
        int3()
        puts("resumed after int3 (")
        put_u64(get_breakpoints())
        puts(" so far)\n")
    } else if line_starts_with("crash") {
        cmd_crash()
    } else if line_is("reboot") {
        reboot()
    } else if line_is("shutdown") {
        shutdown()
    } else {
        set_color(red)
        puts("unknown command: ")
        for i in 0..line_len {
            putc(line[i])
        }
        putc('\n')
        set_color(white)
    }
}

/// Reads one line with echo and backspace.
fn read_line() {
    line_len = 0
    loop {
        let c = read_key()
        if c == key_enter {
            putc('\n')
            return
        }
        if c == key_backspace {
            if line_len > 0 {
                line_len -= 1
                putc(key_backspace)
                putc(' ')
                putc(key_backspace)
            }
            continue
        }
        if c >= 32 && c < 127 && line_len < line_max {
            line[line_len] = c
            line_len += 1
            putc(c)
        }
    }
}

/// GDT, TSS and exception handlers (run again after moving to the
/// higher half, so every address the CPU keeps is a high one).
fn cpu_init() {
    gdt_init()
    exceptions_init()
}

/// UEFI entry point: takes over the machine, then jumps to the higher half.
fn main() {
    efi_init()
    has_fb = fb_init()
    con_init(has_fb)

    // From here on, no more firmware boot services.
    if !exit_boot_services() {
        panic("ExitBootServices failed")
    }
    cli()
    cpu_init()
    pmm_init()
    paging_init()
    enter_higher_half(kmain)
}

/// Runs in the higher half, on the kernel stack: finishes the setup and
/// starts the shell.
fn kmain() {
    cpu_init()
    reclaimed_pages = pmm_reclaim_boot_services()
    irq_init()
    kbd_init()
    sti()
    print("PsycOS: boot ok")
    banner()
    loop {
        prompt()
        read_line()
        run_command()
    }
}
