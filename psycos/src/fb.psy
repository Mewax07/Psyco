/// Wiki Doc sources:
///   - https://wiki.osdev.org/GOP
///   - https://wiki.osdev.org/Drawing_In_a_Linear_Framebuffer
///   - https://uefi.org/specs/UEFI/2.10/12_Protocols_Console_Support.html

#![trusted]

import "efi.psy"
import "sync.psy"

const pixel_rgb: u32 = 0
const pixel_bgr: u32 = 1
const bytes_per_pixel: usize = 4
const max_modes: usize = 64
const max_dirty: usize = 16
const fb_page_bytes: usize = 4096

struct GopModeInfo {
    version: u32,
    width: u32,
    height: u32,
    pixel_format: u32,
    red_mask: u32,
    green_mask: u32,
    blue_mask: u32,
    reserved_mask: u32,
    pixels_per_scan_line: u32,
}

struct GopMode {
    max_mode: u32,
    mode: u32,
    info: *mut GopModeInfo,
    size_of_info: usize,
    frame_buffer_base: u64,
    frame_buffer_size: usize,
}

struct Gop {
    query_mode: extern fn(*mut Gop, u32, *mut usize, *mut *mut GopModeInfo) -> u64,
    set_mode: extern fn(*mut Gop, u32) -> u64,
    blt: *mut u8,
    mode: *mut GopMode,
}

struct DirtyRect {
    x: usize,
    y: usize,
    w: usize,
    h: usize,
}

struct VideoMode {
    number: u32,
    width: u32,
    height: u32,
}

#[getter]
static mut fb_base: *mut u32
#[getter]
static mut fb_size: usize = 0
#[getter]
static mut fb_width: usize = 0
#[getter]
static mut fb_height: usize = 0
#[getter]
static mut fb_stride: usize = 0
#[getter]
static mut fb_rgb: bool = false
#[getter]
static mut fb_phys: u64 = 0
#[getter]
static mut fb_locked: bool = false

static mut back: *mut u32
static mut back_stride: usize = 0
static mut back_phys: u64 = 0
static mut back_pages: usize = 0
#[getter]
static mut fb_double: bool = false
static mut dirty: [DirtyRect; 16]
static mut dirty_count: usize = 0
static mut batch_depth: usize = 0
#[getter]
static mut flushed_bytes: u64 = 0

static mut modes: [VideoMode; 64]
#[getter]
static mut mode_count: usize = 0
#[getter]
static mut mode_current: usize = 0

fn fb_init() -> bool {
    return fb_setup(false, 0, 0)
}

fn fb_init_mode(want_w: usize, want_h: usize) -> bool {
    return fb_setup(true, want_w, want_h)
}

fn fb_setup(switch: bool, want_w: usize, want_h: usize) -> bool {
    let guid = Guid {
        d1: 0x9042a9de,
        d2: 0x23dc,
        d3: 0x4a38,
        d4: [0x96, 0xfb, 0x7a, 0xde, 0xd0, 0x80, 0x51, 0x6a],
    }
    let bs = (*st).boot_services
    let mut found = 0 as *mut u8
    let status = (*bs).locate_protocol(&guid as *const Guid, 0 as *mut u8, &mut found as *mut *mut u8)
    if status != 0 || found.is_null() {
        return false
    }
    let gop = found as *mut Gop
    list_modes(gop)
    let choice = choose_mode(want_w, want_h)
    if switch && choice < mode_count && modes[choice].number != (*(*gop).mode).mode {
        (*gop).set_mode(gop, modes[choice].number)
    }
    if !read_mode(gop) {
        return false
    }
    setup_back_buffer()
    return true
}

fn setup_back_buffer() {
    let pages = (fb_width * fb_height * bytes_per_pixel + fb_page_bytes - 1) / fb_page_bytes
    if pages > back_pages {
        efi_free_pages(back_phys, back_pages)
        back_phys = efi_alloc_pages(pages)
        back_pages = pages
        if back_phys == 0 {
            back_pages = 0
        }
    }
    dirty_count = 0
    fb_double = back_phys != 0
    if fb_double {
        back = back_phys as *mut u32
        back_stride = fb_width
        memset32(back, 0, fb_width * fb_height)
    } else {
        back = fb_base
        back_stride = fb_stride
    }
}

fn list_modes(gop: *mut Gop) {
    mode_count = 0
    let max = (*(*gop).mode).max_mode
    for n in 0..max {
        let mut size: usize = 0
        let mut info = 0 as *mut GopModeInfo
        if (*gop).query_mode(gop, n, &mut size as *mut usize, &mut info as *mut *mut GopModeInfo) != 0 || info.is_null() {
            continue
        }
        let format = (*info).pixel_format
        if (format == pixel_rgb || format == pixel_bgr) && mode_count < max_modes {
            modes[mode_count] = VideoMode { number: n, width: (*info).width, height: (*info).height }
            mode_count += 1
        }
    }
}

fn choose_mode(want_w: usize, want_h: usize) -> usize {
    let mut best = mode_count
    let mut best_area: usize = 0
    for i in 0..mode_count {
        let w = modes[i].width as usize
        let h = modes[i].height as usize
        if w == want_w && h == want_h {
            return i
        }
        if w * h > best_area {
            best = i
            best_area = w * h
        }
    }
    return best
}

fn read_mode(gop: *mut Gop) -> bool {
    let mode = (*gop).mode
    let info = (*mode).info
    let format = (*info).pixel_format
    if format != pixel_rgb && format != pixel_bgr {
        return false
    }
    fb_base = (*mode).frame_buffer_base as *mut u32
    fb_phys = (*mode).frame_buffer_base
    fb_size = (*mode).frame_buffer_size
    fb_width = (*info).width as usize
    fb_height = (*info).height as usize
    fb_stride = (*info).pixels_per_scan_line as usize
    fb_rgb = format == pixel_rgb
    mode_current = mode_count
    for i in 0..mode_count {
        if modes[i].number == (*mode).mode {
            mode_current = i
        }
    }
    return !fb_base.is_null() && fb_width > 0 && fb_height > 0
}

fn video_mode(i: usize) -> VideoMode {
    return modes[i]
}

fn fb_move(new_base: u64) {
    fb_base = new_base as *mut u32
    if !fb_double {
        back = fb_base
    }
}

fn fb_back_phys() -> u64 {
    if fb_double {
        return back_phys
    }
    return 0
}

fn fb_move_back(new_base: u64) {
    if fb_double {
        back = new_base as *mut u32
    }
}

fn fb_lock() {
    fb_locked = true
}

fn fb_unlock() {
    fb_locked = false
    mark_dirty(0, 0, fb_width, fb_height)
    fb_flush()
}

fn fb_batch_begin() {
    batch_depth += 1
}

fn fb_batch_end() {
    if batch_depth > 0 {
        batch_depth -= 1
    }
    if batch_depth == 0 {
        fb_flush()
    }
}

fn touching(a: DirtyRect, b: DirtyRect) -> bool {
    return a.x <= b.x + b.w && b.x <= a.x + a.w && a.y <= b.y + b.h && b.y <= a.y + a.h
}

fn rect_union(a: DirtyRect, b: DirtyRect) -> DirtyRect {
    let x0 = smaller(a.x, b.x)
    let y0 = smaller(a.y, b.y)
    let x1 = larger(a.x + a.w, b.x + b.w)
    let y1 = larger(a.y + a.h, b.y + b.h)
    return DirtyRect { x: x0, y: y0, w: x1 - x0, h: y1 - y0 }
}

fn smaller(a: usize, b: usize) -> usize {
    if a < b {
        return a
    }
    return b
}

fn larger(a: usize, b: usize) -> usize {
    if a > b {
        return a
    }
    return b
}

fn mark_dirty(x: usize, y: usize, w: usize, h: usize) {
    if !fb_double {
        return
    }
    let was_on = irq_save()
    let mut r = DirtyRect { x: x, y: y, w: w, h: h }
    let mut i: usize = 0
    while i < dirty_count {
        if touching(dirty[i], r) {
            r = rect_union(dirty[i], r)
            dirty_count -= 1
            dirty[i] = dirty[dirty_count]
            i = 0
        } else {
            i += 1
        }
    }
    if dirty_count == max_dirty {
        for k in 0..dirty_count {
            r = rect_union(dirty[k], r)
        }
        dirty_count = 0
    }
    dirty[dirty_count] = r
    dirty_count += 1
    irq_restore(was_on)
    if batch_depth == 0 {
        fb_flush()
    }
}

fn fb_flush() {
    if !fb_double || fb_locked {
        return
    }
    let was_on = irq_save()
    for i in 0..dirty_count {
        let r = dirty[i]
        for j in 0..r.h {
            let src = back.add((r.y + j) * back_stride + r.x)
            let dst = fb_base.add((r.y + j) * fb_stride + r.x)
            memcpy(dst as *mut u8, src as *const u8, r.w * bytes_per_pixel)
        }
        flushed_bytes += (r.w * r.h * bytes_per_pixel) as u64
    }
    dirty_count = 0
    irq_restore(was_on)
}

fn fb_dirty_count() -> usize {
    return dirty_count
}

fn screen_pixel(x: usize, y: usize) -> u32 {
    if x >= fb_width || y >= fb_height {
        return 0
    }
    return to_native(fb_base.add(y * fb_stride + x).read())
}

fn to_native(color: u32) -> u32 {
    if fb_rgb {
        return ((color & 0xFF) << 16) | (color & 0xFF00) | ((color >> 16) & 0xFF)
    }
    return color & 0xFFFFFF
}

fn put_pixel(x: usize, y: usize, color: u32) {
    if fb_locked && !fb_double {
        return
    }
    if x >= fb_width || y >= fb_height {
        return
    }
    back.add(y * back_stride + x).write(to_native(color))
    mark_dirty(x, y, 1, 1)
}

fn get_pixel(x: usize, y: usize) -> u32 {
    if x >= fb_width || y >= fb_height {
        return 0
    }
    return to_native(back.add(y * back_stride + x).read())
}

fn fill_rect(x: usize, y: usize, w: usize, h: usize, color: u32) {
    if fb_locked && !fb_double {
        return
    }
    if x >= fb_width || y >= fb_height {
        return
    }
    let mut cw = w
    let mut ch = h
    if cw > fb_width - x {
        cw = fb_width - x
    }
    if ch > fb_height - y {
        ch = fb_height - y
    }
    if cw == 0 || ch == 0 {
        return
    }
    let c = to_native(color)
    let mut row = back.add(y * back_stride + x)
    for j in 0..ch {
        memset32(row, c, cw)
        row = row.add(back_stride)
    }
    mark_dirty(x, y, cw, ch)
}

fn fb_scroll_up(dy: usize, color: u32) {
    if fb_locked && !fb_double {
        return
    }
    if dy >= fb_height {
        fill_rect(0, 0, fb_width, fb_height, color)
        return
    }
    fb_batch_begin()
    let line = back_stride * bytes_per_pixel
    memcpy(back as *mut u8, back.add(dy * back_stride) as *const u8, (fb_height - dy) * line)
    mark_dirty(0, 0, fb_width, fb_height - dy)
    fill_rect(0, fb_height - dy, fb_width, dy, color)
    fb_batch_end()
}
