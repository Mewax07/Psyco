/// Wiki Doc sources:
///   - https://wiki.osdev.org/GOP
///   - https://wiki.osdev.org/Drawing_In_a_Linear_Framebuffer
///   - https://uefi.org/specs/UEFI/2.10/12_Protocols_Console_Support.html
///
/// Linear framebuffer from the UEFI Graphics Output Protocol (GOP).
/// fb_init() must run before ExitBootServices: it lists the video modes,
/// can switch mode (fb_init_mode) and reads the address of the
/// framebuffer. After that, drawing writes straight to video memory.
/// Colors are always 0x00RRGGBB, whatever the byte order of the screen.

#![trusted]

import "efi.psy"

const pixel_rgb: u32 = 0
const pixel_bgr: u32 = 1
const bytes_per_pixel: usize = 4
const max_modes: usize = 64

struct GopModeInfo {
    version: u32,
    width: u32,
    height: u32,
    pixel_format: u32,
    red_mask: u32,
    green_mask: u32,
    blue_mask: u32,
    reserved_mask: u32,
    pixels_per_scan_line: u32,
}

struct GopMode {
    max_mode: u32,
    mode: u32,
    info: *mut GopModeInfo,
    size_of_info: usize,
    frame_buffer_base: u64,
    frame_buffer_size: usize,
}

struct Gop {
    query_mode: extern fn(*mut Gop, u32, *mut usize, *mut *mut GopModeInfo) -> u64,
    set_mode: extern fn(*mut Gop, u32) -> u64,
    blt: *mut u8,
    mode: *mut GopMode,
}

struct VideoMode {
    number: u32,
    width: u32,
    height: u32,
}

#[getter]
static mut fb_base: *mut u32
#[getter]
static mut fb_size: usize = 0
#[getter]
static mut fb_width: usize = 0
#[getter]
static mut fb_height: usize = 0
static mut fb_stride: usize = 0
static mut fb_rgb: bool = false

static mut modes: [VideoMode; 64]
#[getter]
static mut mode_count: usize = 0
#[getter]
static mut mode_current: usize = 0

fn fb_init() -> bool {
    return fb_setup(false, 0, 0)
}

/// Like fb_init, but switches to `want_w` x `want_h` if the firmware has
/// it, else to the largest mode (0 x 0: the largest).
fn fb_init_mode(want_w: usize, want_h: usize) -> bool {
    return fb_setup(true, want_w, want_h)
}

/// Finds the GOP, lists its modes, switches mode if asked, reads the result.
fn fb_setup(switch: bool, want_w: usize, want_h: usize) -> bool {
    let guid = Guid {
        d1: 0x9042a9de,
        d2: 0x23dc,
        d3: 0x4a38,
        d4: [0x96, 0xfb, 0x7a, 0xde, 0xd0, 0x80, 0x51, 0x6a],
    }
    let bs = (*st).boot_services
    let mut found = 0 as *mut u8
    let status = (*bs).locate_protocol(&guid as *const Guid, 0 as *mut u8, &mut found as *mut *mut u8)
    if status != 0 || found.is_null() {
        return false
    }
    let gop = found as *mut Gop
    list_modes(gop)
    let choice = choose_mode(want_w, want_h)
    if switch && choice < mode_count && modes[choice].number != (*(*gop).mode).mode {
        (*gop).set_mode(gop, modes[choice].number)
    }
    return read_mode(gop)
}

/// Fills `modes` with the 32-bit modes of the GOP.
fn list_modes(gop: *mut Gop) {
    mode_count = 0
    let max = (*(*gop).mode).max_mode
    for n in 0..max {
        let mut size: usize = 0
        let mut info = 0 as *mut GopModeInfo
        if (*gop).query_mode(gop, n, &mut size as *mut usize, &mut info as *mut *mut GopModeInfo) != 0 || info.is_null() {
            continue
        }
        let format = (*info).pixel_format
        if (format == pixel_rgb || format == pixel_bgr) && mode_count < max_modes {
            modes[mode_count] = VideoMode { number: n, width: (*info).width, height: (*info).height }
            mode_count += 1
        }
    }
}

/// Index in `modes` of the requested size, else of the largest mode.
fn choose_mode(want_w: usize, want_h: usize) -> usize {
    let mut best = mode_count
    let mut best_area: usize = 0
    for i in 0..mode_count {
        let w = modes[i].width as usize
        let h = modes[i].height as usize
        if w == want_w && h == want_h {
            return i
        }
        if w * h > best_area {
            best = i
            best_area = w * h
        }
    }
    return best
}

/// Saves the framebuffer of the current mode.
fn read_mode(gop: *mut Gop) -> bool {
    let mode = (*gop).mode
    let info = (*mode).info
    let format = (*info).pixel_format
    if format != pixel_rgb && format != pixel_bgr {
        return false
    }
    fb_base = (*mode).frame_buffer_base as *mut u32
    fb_size = (*mode).frame_buffer_size
    fb_width = (*info).width as usize
    fb_height = (*info).height as usize
    fb_stride = (*info).pixels_per_scan_line as usize
    fb_rgb = format == pixel_rgb
    mode_current = mode_count
    for i in 0..mode_count {
        if modes[i].number == (*mode).mode {
            mode_current = i
        }
    }
    return !fb_base.is_null() && fb_width > 0 && fb_height > 0
}

/// The `i`-th video mode listed at boot.
fn video_mode(i: usize) -> VideoMode {
    return modes[i]
}

/// Uses another virtual address for the same framebuffer.
fn fb_move(new_base: u64) {
    fb_base = new_base as *mut u32
}

/// Converts 0x00RRGGBB to the framebuffer byte order (its own inverse).
fn to_native(color: u32) -> u32 {
    if fb_rgb {
        return ((color & 0xFF) << 16) | (color & 0xFF00) | ((color >> 16) & 0xFF)
    }
    return color & 0xFFFFFF
}

/// Draws one pixel (ignored outside the screen).
fn put_pixel(x: usize, y: usize, color: u32) {
    if x >= fb_width || y >= fb_height {
        return
    }
    fb_base.add(y * fb_stride + x).write(to_native(color))
}

/// Reads one pixel back (0 outside the screen).
fn get_pixel(x: usize, y: usize) -> u32 {
    if x >= fb_width || y >= fb_height {
        return 0
    }
    return to_native(fb_base.add(y * fb_stride + x).read())
}

/// Fills a rectangle, clipped to the screen.
fn fill_rect(x: usize, y: usize, w: usize, h: usize, color: u32) {
    if x >= fb_width || y >= fb_height {
        return
    }
    let mut cw = w
    let mut ch = h
    if cw > fb_width - x {
        cw = fb_width - x
    }
    if ch > fb_height - y {
        ch = fb_height - y
    }
    let c = to_native(color)
    let mut row = fb_base.add(y * fb_stride + x)
    for j in 0..ch {
        memset32(row, c, cw)
        row = row.add(fb_stride)
    }
}

/// Moves the whole screen up by `dy` pixel rows and clears the bottom.
/// The copy goes to lower addresses, so a forward copy is safe.
fn fb_scroll_up(dy: usize, color: u32) {
    if dy >= fb_height {
        fill_rect(0, 0, fb_width, fb_height, color)
        return
    }
    let line = fb_stride * bytes_per_pixel
    memcpy(fb_base as *mut u8, fb_base.add(dy * fb_stride) as *const u8, (fb_height - dy) * line)
    fill_rect(0, fb_height - dy, fb_width, dy, color)
}
