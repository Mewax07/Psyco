/// Wiki Doc sources:
///   - https://wiki.osdev.org/Programmable_Interval_Timer
///   - https://wiki.osdev.org/8259_PIC#Spurious_IRQs
///   - https://wiki.osdev.org/APIC_Timer

import "idt.psy"
import "pic.psy"
import "cpu.psy"

const timer_hz: u64 = 100
const timer_irq: u8 = 0
const timer_vector: usize = 32
const irq_first_vector: usize = 32
const irq_last_vector: usize = 47
const spurious7_vector: usize = 39
const spurious15_vector: usize = 47
const apic_spurious_vector: usize = 255

#[getter]
static mut ticks: u64 = 0
#[getter]
static mut spurious_irqs: u64 = 0
#[getter]
static mut other_irqs: u64 = 0

#[setter]
static mut tick_hook: fn()
#[setter]
static mut poll_hook: fn()

fn irq_init() {
    pic_init()
    for v in irq_first_vector..irq_last_vector + 1 {
        idt_set_gate(v, irq_other as u64, 0)
    }
    idt_set_gate(timer_vector, irq_timer as u64, 0)
    idt_set_gate(spurious7_vector, irq_spurious7 as u64, 0)
    idt_set_gate(spurious15_vector, irq_spurious15 as u64, 0)
    idt_load()

    pit_set_frequency(timer_hz)
    pic_unmask(timer_irq)
}

#[interrupt]
fn irq_timer(frame: &Frame) {
    kernel_lock()
    ticks += 1
    pic_eoi(timer_irq)
    if poll_hook as u64 != 0 {
        let poll = poll_hook
        poll()
    }
    if tick_hook as u64 != 0 {
        let hook = tick_hook
        hook()
    }
    kernel_unlock()
}

#[interrupt]
fn irq_spurious7(frame: &Frame) {
    kernel_lock()
    if pic_spurious(7) {
        spurious_irqs += 1
    } else {
        other_irqs += 1
        pic_eoi(7)
    }
    kernel_unlock()
}

#[interrupt]
fn irq_spurious15(frame: &Frame) {
    kernel_lock()
    if pic_spurious(15) {
        spurious_irqs += 1
    } else {
        other_irqs += 1
        pic_eoi(15)
    }
    kernel_unlock()
}

#[interrupt]
fn irq_other(frame: &Frame) {
    kernel_lock()
    other_irqs += 1
    pic_eoi(8)
    kernel_unlock()
}

fn irq_use_apic() -> bool {
    if !apic_init(apic_spurious_vector) {
        return false
    }
    pic_switch_to_apic()
    lapic_timer_start(timer_vector as u32, get_lapic_ticks_10ms() * 100 / timer_hz)
    return true
}

fn uptime_ms() -> u64 {
    return ticks * 1000 / timer_hz
}

fn sleep_ms(ms: u64) {
    let target = ticks + (ms * timer_hz + 999) / 1000
    while ticks < target {
        hlt()
    }
}
