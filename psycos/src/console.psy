/// Wiki Doc sources:
///   - https://wiki.osdev.org/Drawing_In_a_Linear_Framebuffer
///   - https://wiki.osdev.org/VGA_Fonts
///
/// Text console drawn in the framebuffer (normal code, not trusted).
/// Grid of font_w x font_h cells, underline cursor, line wrap and scrolling.
/// Everything is also copied to the serial port, so the kernel can be
/// followed from a terminal (and tested automatically).

import "fb.psy"
import "font.psy"
import "serial.psy"

// Palette (0xRRGGBB), close to the 16 VGA colors.
const black: u32 = 0x000000
const gray: u32 = 0xAAAAAA
const dark_gray: u32 = 0x555555
const blue: u32 = 0x5555FF
const green: u32 = 0x55FF55
const cyan: u32 = 0x55FFFF
const red: u32 = 0xFF5555
const magenta: u32 = 0xFF55FF
const yellow: u32 = 0xFFFF55
const white: u32 = 0xFFFFFF

const cursor_height: usize = 2
const tab_width: usize = 8
const key_backspace_code: u8 = 8

#[getter]
static mut con_cols: usize = 0
#[getter]
static mut con_rows: usize = 0
#[getter]
static mut con_x: usize = 0
#[getter]
static mut con_y: usize = 0
static mut con_fg: u32 = gray
static mut con_bg: u32 = black
static mut con_ready: bool = false
#[setter]
static mut con_mirror: bool = true

/// Sets up the grid; without a framebuffer, only the serial copy works.
fn con_init(has_fb: bool) {
    if has_fb {
        con_cols = get_fb_width() / font_w
        con_rows = get_fb_height() / font_h
        con_ready = con_cols > 0 && con_rows > 0
    }
    clear()
}

/// Clears the screen and moves the cursor home.
fn clear() {
    con_x = 0
    con_y = 0
    if con_ready {
        fill_rect(0, 0, get_fb_width(), get_fb_height(), con_bg)
        draw_cursor(con_fg)
    }
}

/// Sets the text color.
fn set_color(fg: u32) {
    con_fg = fg
}

/// Sets the text and background colors.
fn set_colors(fg: u32, bg: u32) {
    con_fg = fg
    con_bg = bg
}

/// Draws (or erases) the underline cursor.
fn draw_cursor(color: u32) {
    if !con_ready {
        return
    }
    fill_rect(con_x * font_w, con_y * font_h + font_h - cursor_height, font_w, cursor_height, color)
}

/// Draws one character in a cell.
fn draw_glyph(c: u8, col: usize, row: usize) {
    let mut code = c as usize
    if code >= 128 {
        code = '?'
    }
    let x0 = col * font_w
    let y0 = row * font_h
    for y in 0..font_h {
        let bits = font[code * font_h + y]
        for x in 0..font_w {
            if bits & (0x80u8 >> x as u8) != 0 {
                put_pixel(x0 + x, y0 + y, con_fg)
            } else {
                put_pixel(x0 + x, y0 + y, con_bg)
            }
        }
    }
}

/// Goes to the next line, scrolling at the bottom.
fn newline() {
    con_x = 0
    if con_y + 1 < con_rows {
        con_y += 1
    } else {
        fb_scroll_up(font_h, con_bg)
    }
}

/// Prints one character (\n, \r, \t and backspace included).
fn putc(c: u8) {
    if con_mirror {
        serial_putc(c)
    }
    if !con_ready {
        return
    }
    draw_cursor(con_bg)
    if c == '\n' {
        newline()
    } else if c == '\r' {
        con_x = 0
    } else if c == key_backspace_code {
        if con_x > 0 {
            con_x -= 1
        }
    } else if c == '\t' {
        con_x = (con_x / tab_width + 1) * tab_width
        if con_x >= con_cols {
            newline()
        }
    } else {
        draw_glyph(c, con_x, con_y)
        con_x += 1
        if con_x == con_cols {
            newline()
        }
    }
    draw_cursor(con_fg)
}

/// Prints a string.
fn puts(s: Str) {
    for i in 0..s.len() {
        putc(str_byte(s, i))
    }
}

/// Prints an unsigned number in decimal.
fn put_u64(n: u64) {
    let mut digits = [0u8; 20]
    let mut count: usize = 0
    let mut v = n
    loop {
        digits[count] = (v % 10) as u8 + '0'
        count += 1
        v /= 10
        if v == 0 {
            break
        }
    }
    while count > 0 {
        count -= 1
        putc(digits[count])
    }
}

/// Prints a signed number in decimal.
fn put_i64(n: i64) {
    if n < 0 {
        putc('-')
        // -(n + 1) + 1 avoids overflowing on i64::MIN.
        put_u64((-(n + 1)) as u64 + 1)
    } else {
        put_u64(n as u64)
    }
}

/// Prints a number in hex, without leading zeros.
fn put_hex(n: u64) {
    let mut shift: u64 = 64
    let mut started = false
    while shift > 0 {
        shift -= 4
        let d = ((n >> shift) & 0xF) as u8
        if d != 0 || started || shift == 0 {
            put_hex_digit(d)
            started = true
        }
    }
}

/// Prints a number in hex on exactly `digits` digits.
fn put_hex_width(n: u64, digits: u64) {
    let mut shift = digits * 4
    while shift > 0 {
        shift -= 4
        put_hex_digit(((n >> shift) & 0xF) as u8)
    }
}

/// Prints one hex digit.
fn put_hex_digit(d: u8) {
    if d < 10 {
        putc('0' + d)
    } else {
        putc('A' + d - 10)
    }
}
