/// Wiki Doc sources:
///   - https://wiki.osdev.org/Serial_Ports
///
/// COM1 serial port. The psycoc runtime already initializes it at boot
/// (38400 baud, 8N1), so this file only reads and writes bytes.
/// Works before and after ExitBootServices.

#![trusted]

const com1: u16 = 0x3F8
const com1_line_status: u16 = 0x3FD
const lsr_data_ready: u8 = 0x01
const lsr_transmit_empty: u8 = 0x20

/// Sends one byte, turning '\n' into "\r\n".
fn serial_putc(c: u8) {
    if c == '\n' {
        serial_raw('\r')
    }
    serial_raw(c)
}

/// Sends one byte as is, waiting for the transmitter.
fn serial_raw(c: u8) {
    while inb(com1_line_status) & lsr_transmit_empty == 0 {
        pause()
    }
    outb(com1, c)
}

/// Received byte, or -1 if nothing arrived (non-blocking).
fn serial_poll() -> i32 {
    if inb(com1_line_status) & lsr_data_ready == 0 {
        return -1
    }
    return inb(com1) as i32
}
