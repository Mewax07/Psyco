/// Wiki Doc sources:
///   - https://wiki.osdev.org/Drawing_In_a_Linear_Framebuffer
///   - https://wiki.osdev.org/Paging

import "fb.psy"
import "sched.psy"
import "paging.psy"
import "bytes.psy"
import "console.psy"
import "usermode.psy"
import "../user/psy/abi.psy" as abi

const display_area: u64 = 0x0000580000000000

static mut display_owner: u64 = 0
#[getter]
static mut display_held: bool = false

fn display_claim() -> i64 {
    if display_active() {
        return -abi::err_busy
    }
    if get_fb_phys() == 0 {
        return -abi::err_nosys
    }
    let root = read_cr3()
    let pages = pages_for(get_fb_size() as u64)
    for p in 0..pages {
        let va = display_area + p * size_4k
        if translate_in(root, va) == not_mapped {
            if !map_page_in(root, va, get_fb_phys() + p * size_4k, pte_user | pte_writable | pte_shared) {
                return -abi::err_nomem
            }
        }
    }
    display_owner = current_task_id()
    display_held = true
    fb_lock()
    return display_area as i64
}

fn display_info(buf: u64) -> i64 {
    let mut raw = [0u8; 32]
    let words = [get_fb_width() as u64, get_fb_height() as u64, get_fb_stride() as u64, get_fb_rgb() as u64]
    for w in 0..4usize {
        for b in 0..8usize {
            raw[w * 8 + b] = (words[w] >> (8 * b as u64)) as u8
        }
    }
    if !copy_to_user(buf, &raw) {
        return -abi::err_fault
    }
    return 0
}

fn display_active() -> bool {
    if display_held && !task_alive(display_owner) {
        display_held = false
        fb_unlock()
        puts("[display] window server gone: text console back\n")
    }
    return display_held
}

fn display_poll() {
    display_active()
}
