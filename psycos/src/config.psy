/// Wiki Doc sources:
///   - https://uefi.org/specs/UEFI/2.10/13_Protocols_Media_Access.html

import "efi.psy"
import "bytes.psy"

const config_max: usize = 1024

struct VideoSize {
    width: usize,
    height: usize,
}

struct ConfigRange {
    start: usize,
    end: usize,
}

static mut config_text: [u8; 1024]
#[getter]
static mut config_len: usize = 0

fn config_load() {
    let n = efi_read_file(u"\\psyos.cfg", &mut config_text)
    if n > 0 {
        config_len = n as usize
    } else {
        config_len = 0
    }
}

fn config_find(key: Str) -> Option<ConfigRange> {
    let k = key.as_bytes()
    let mut line: usize = 0
    while line < config_len {
        let mut end = line
        while end < config_len && config_text[end] != '\n' {
            end += 1
        }
        let mut value_end = end
        while value_end > line && (config_text[value_end - 1] == '\r' || config_text[value_end - 1] == ' ') {
            value_end -= 1
        }
        if value_end - line > k.len() && config_text[line + k.len()] == '=' {
            if bytes_equal(&config_text[line..line + k.len()], k) {
                return Some(ConfigRange { start: line + k.len() + 1, end: value_end })
            }
        }
        line = end + 1
    }
    return None
}

fn config_is(key: Str, value: Str) -> bool {
    let Some(r) = config_find(key) else {
        return false
    }
    return bytes_equal(&config_text[r.start..r.end], value.as_bytes())
}

fn parse_decimal(r: ConfigRange, pos: &mut usize) -> usize {
    let mut v: usize = 0
    while *pos < r.end && config_text[*pos] >= '0' && config_text[*pos] <= '9' {
        v = v * 10 + (config_text[*pos] - '0') as usize
        *pos += 1
    }
    return v
}

fn config_video() -> VideoSize {
    let largest = VideoSize { width: 0, height: 0 }
    let Some(r) = config_find("video") else {
        return largest
    }
    let mut pos = r.start
    let w = parse_decimal(r, &mut pos)
    if pos >= r.end || config_text[pos] != 'x' {
        return largest
    }
    pos += 1
    let h = parse_decimal(r, &mut pos)
    if pos != r.end {
        return largest
    }
    return VideoSize { width: w, height: h }
}
