/// Wiki Doc sources:
///   - https://wiki.osdev.org/Global_Descriptor_Table
///   - https://wiki.osdev.org/GDT_Tutorial
///   - https://wiki.osdev.org/Task_State_Segment

#![trusted]

const kernel_cs: u16 = 0x08
const kernel_ds: u16 = 0x10
const tss_selector: u16 = 0x18
const user_base_selector: u64 = 0x28

const user_ds: u64 = 0x33
const user_cs: u64 = 0x3B

const gdt_kernel_code: u64 = 0x00AF9A000000FFFF
const gdt_kernel_data: u64 = 0x00CF92000000FFFF
const gdt_user_data: u64 = 0x00CFF2000000FFFF
const gdt_user_code: u64 = 0x00AFFA000000FFFF
const gdt_tss_available: u64 = 0x89

const ist_double_fault: u8 = 1
const df_stack_size: usize = 16384
const gdt_cpus: usize = 16
const gdt_entries: usize = 8

#[packed]
struct DescriptorTablePointer {
    limit: u16,
    base: u64,
}

#[packed]
struct Tss {
    reserved0: u32,
    rsp0: u64,
    rsp1: u64,
    rsp2: u64,
    reserved1: u64,
    ist1: u64,
    ist2: u64,
    ist3: u64,
    ist4: u64,
    ist5: u64,
    ist6: u64,
    ist7: u64,
    reserved2: u64,
    reserved3: u16,
    iomap_base: u16,
}

static mut gdt: [u64; 128]
static mut gdtr: [DescriptorTablePointer; 16]
static mut tss: [Tss; 16]
#[align(16)]
static mut df_stack: [u8; 16384]
#[getter]
static mut gdt_ready: bool = false

fn gdt_init() {
    gdt_init_cpu(0, df_stack_top())
}

fn gdt_init_cpu(cpu: usize, ist1: u64) {
    if cpu >= gdt_cpus {
        panic("gdt_init_cpu: too many processors")
    }
    let g = cpu * gdt_entries
    gdt[g] = 0
    gdt[g + 1] = gdt_kernel_code
    gdt[g + 2] = gdt_kernel_data
    gdt[g + 5] = 0
    gdt[g + 6] = gdt_user_data
    gdt[g + 7] = gdt_user_code

    tss[cpu].ist1 = ist1
    tss[cpu].iomap_base = sizeof(Tss) as u16

    let base = &mut tss[cpu] as *mut Tss as u64
    let limit = sizeof(Tss) as u64 - 1
    gdt[g + 3] = (limit & 0xFFFF) | ((base & 0xFFFFFF) << 16) | (gdt_tss_available << 40) | (((limit >> 16) & 0xF) << 48) | (((base >> 24) & 0xFF) << 56)
    gdt[g + 4] = base >> 32

    gdtr[cpu].limit = (gdt_entries * 8 - 1) as u16
    gdtr[cpu].base = &gdt[g] as *const u64 as u64
    lgdt(&gdtr[cpu])

    load_cs(kernel_cs)
    load_ds(kernel_ds)
    ltr(tss_selector)
    gdt_ready = true
}

fn tss_set_rsp0(cpu: usize, top: u64) {
    tss[cpu].rsp0 = top
}

fn df_stack_bottom() -> u64 {
    return df_stack.as_ptr() as u64
}

fn df_stack_top() -> u64 {
    return df_stack.as_ptr() as u64 + df_stack_size as u64
}

fn gdt_address() -> u64 {
    return gdtr[0].base
}

fn gdt_entry(i: usize) -> u64 {
    return gdt[i]
}

fn tss_ist1() -> u64 {
    return tss[0].ist1
}

fn tss_address() -> u64 {
    return &mut tss[0] as *mut Tss as u64
}

fn tss_size() -> usize {
    return sizeof(Tss)
}
