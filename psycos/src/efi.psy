/// Wiki Doc sources:
///   - https://wiki.osdev.org/UEFI
///   - https://uefi.org/specs/UEFI/2.10/04_EFI_System_Table.html
///   - https://uefi.org/specs/UEFI/2.10/07_Services_Boot_Services.html
///   - https://uefi.org/specs/UEFI/2.10/08_Services_Runtime_Services.html
///   - https://uefi.org/specs/UEFI/2.10/09_Protocols_EFI_Loaded_Image.html
///
/// UEFI tables and the few firmware services the kernel still needs.
/// The memory map is read right before ExitBootServices and kept here:
/// it is the only description of RAM the kernel has.

#![trusted]

const max_exit_attempts: i64 = 8

const mem_loader_code: u32 = 1
const mem_loader_data: u32 = 2
const mem_boot_services_code: u32 = 3
const mem_boot_services_data: u32 = 4
const mem_conventional: u32 = 7

const reset_cold: u32 = 0
const reset_shutdown: u32 = 2

struct TableHeader {
    signature: u64,
    revision: u32,
    header_size: u32,
    crc32: u32,
    reserved: u32,
}

struct InputKey {
    scan_code: u16,
    unicode_char: u16,
}

struct SimpleTextInput {
    reset: extern fn(*mut SimpleTextInput, bool) -> u64,
    read_key_stroke: extern fn(*mut SimpleTextInput, *mut InputKey) -> u64,
    wait_for_key: *mut u8,
}

struct SimpleTextOutput {
    reset: extern fn(*mut SimpleTextOutput, bool) -> u64,
    output_string: extern fn(*mut SimpleTextOutput, *const u16) -> u64,
    test_string: *mut u8,
    query_mode: *mut u8,
    set_mode: *mut u8,
    set_attribute: extern fn(*mut SimpleTextOutput, usize) -> u64,
    clear_screen: extern fn(*mut SimpleTextOutput) -> u64,
}

struct Time {
    year: u16,
    month: u8,
    day: u8,
    hour: u8,
    minute: u8,
    second: u8,
    pad1: u8,
    nanosecond: u32,
    time_zone: i16,
    daylight: u8,
    pad2: u8,
}

struct RuntimeServices {
    hdr: TableHeader,
    get_time: extern fn(*mut Time, *mut u8) -> u64,
    set_time: *mut u8,
    get_wakeup_time: *mut u8,
    set_wakeup_time: *mut u8,
    set_virtual_address_map: *mut u8,
    convert_pointer: *mut u8,
    get_variable: *mut u8,
    get_next_variable_name: *mut u8,
    set_variable: *mut u8,
    get_next_high_monotonic_count: *mut u8,
    reset_system: extern fn(u32, u64, usize, *const u8),
}

struct MemoryDescriptor {
    kind: u32,
    pad: u32,
    physical_start: u64,
    virtual_start: u64,
    number_of_pages: u64,
    attribute: u64,
}

struct BootServices {
    hdr: TableHeader,
    raise_tpl: *mut u8,
    restore_tpl: *mut u8,
    allocate_pages: *mut u8,
    free_pages: *mut u8,
    get_memory_map: extern fn(*mut usize, *mut u8, *mut usize, *mut usize, *mut u32) -> u64,
    allocate_pool: *mut u8,
    free_pool: *mut u8,
    create_event: *mut u8,
    set_timer: *mut u8,
    wait_for_event: extern fn(usize, *mut *mut u8, *mut usize) -> u64,
    signal_event: *mut u8,
    close_event: *mut u8,
    check_event: *mut u8,
    install_protocol_interface: *mut u8,
    reinstall_protocol_interface: *mut u8,
    uninstall_protocol_interface: *mut u8,
    handle_protocol: extern fn(*mut u8, *const Guid, *mut *mut u8) -> u64,
    reserved: *mut u8,
    register_protocol_notify: *mut u8,
    locate_handle: *mut u8,
    locate_device_path: *mut u8,
    install_configuration_table: *mut u8,
    load_image: *mut u8,
    start_image: *mut u8,
    exit: *mut u8,
    unload_image: *mut u8,
    exit_boot_services: extern fn(*mut u8, usize) -> u64,
    get_next_monotonic_count: *mut u8,
    stall: *mut u8,
    set_watchdog_timer: extern fn(usize, u64, usize, *const u16) -> u64,
    connect_controller: *mut u8,
    disconnect_controller: *mut u8,
    open_protocol: *mut u8,
    close_protocol: *mut u8,
    open_protocol_information: *mut u8,
    protocols_per_handle: *mut u8,
    locate_handle_buffer: *mut u8,
    locate_protocol: extern fn(*const Guid, *mut u8, *mut *mut u8) -> u64,
}

struct Guid {
    d1: u32,
    d2: u16,
    d3: u16,
    d4: [u8; 8],
}

struct SystemTable {
    hdr: TableHeader,
    firmware_vendor: *const u16,
    firmware_revision: u32,
    console_in_handle: *mut u8,
    con_in: *mut SimpleTextInput,
    console_out_handle: *mut u8,
    con_out: *mut SimpleTextOutput,
    standard_error_handle: *mut u8,
    std_err: *mut SimpleTextOutput,
    runtime_services: *mut RuntimeServices,
    boot_services: *mut BootServices,
}

struct LoadedImage {
    revision: u32,
    parent_handle: *mut u8,
    system_table: *mut u8,
    device_handle: *mut u8,
    file_path: *mut u8,
    reserved: *mut u8,
    load_options_size: u32,
    load_options: *mut u8,
    image_base: *mut u8,
    image_size: u64,
    image_code_type: u32,
    image_data_type: u32,
    unload: *mut u8,
}

// What the rest of the kernel sees of one memory map entry.
struct MemRegion {
    kind: u32,
    start: u64,
    pages: u64,
}

static mut st: *mut SystemTable
static mut map: [u8; 16384]
static mut map_size: usize = 0
static mut map_desc_size: usize = 0

#[getter]
static mut boot_services_done: bool = false

// Where the firmware loaded our PE image (physical, page aligned).
#[getter]
static mut image_base: u64 = 0
#[getter]
static mut image_size: u64 = 0

/// Saves the system table, disables the watchdog, finds our own image.
fn efi_init() {
    st = efi_system_table() as *mut SystemTable
    let bs = (*st).boot_services
    (*bs).set_watchdog_timer(0, 0, 0, 0 as *const u16)
    read_loaded_image()
}

/// Reads the base address and size of the kernel image (LoadedImage).
fn read_loaded_image() {
    let guid = Guid {
        d1: 0x5B1B31A1,
        d2: 0x9562,
        d3: 0x11d2,
        d4: [0x8E, 0x3F, 0x00, 0xA0, 0xC9, 0x69, 0x72, 0x3B],
    }
    let bs = (*st).boot_services
    let mut li = 0 as *mut u8
    let status = (*bs).handle_protocol(efi_image_handle(), &guid as *const Guid, &mut li as *mut *mut u8)
    if status != 0 || li.is_null() {
        return
    }
    let image = li as *mut LoadedImage
    image_base = (*image).image_base as u64
    image_size = (*image).image_size
}

/// Reads the memory map into `map`, returns its key (-1 on error).
fn read_memory_map() -> i64 {
    let bs = (*st).boot_services
    let mut size: usize = map.len()
    let mut key: usize = 0
    let mut desc_size: usize = 0
    let mut version: u32 = 0
    let status = (*bs).get_memory_map(&mut size as *mut usize, map.as_mut_ptr(), &mut key as *mut usize, &mut desc_size as *mut usize, &mut version as *mut u32)
    if status != 0 || desc_size < sizeof(MemoryDescriptor) {
        map_size = 0
        return -1
    }
    map_size = size
    map_desc_size = desc_size
    return key as i64
}

/// Leaves the firmware boot services, retrying if the map key changed.
/// Nothing may allocate memory between GetMemoryMap and ExitBootServices.
/// Afterwards only the runtime services (time, reset) are usable.
fn exit_boot_services() -> bool {
    if boot_services_done {
        return true
    }
    let bs = (*st).boot_services
    let image = efi_image_handle()
    for attempt in 0..max_exit_attempts {
        let key = read_memory_map()
        if key < 0 {
            return false
        }
        if (*bs).exit_boot_services(image, key as usize) == 0 {
            boot_services_done = true
            return true
        }
    }
    return false
}

/// Number of entries in the saved memory map.
fn memory_map_entries() -> usize {
    if map_desc_size == 0 {
        return 0
    }
    return map_size / map_desc_size
}

/// Entry `i` of the saved memory map.
fn memory_region(i: usize) -> MemRegion {
    if i >= memory_map_entries() {
        panic("memory_region: index out of bounds")
    }
    let d = (map.as_ptr() as usize + i * map_desc_size) as *const MemoryDescriptor
    return MemRegion {
        kind: (*d).kind,
        start: (*d).physical_start,
        pages: (*d).number_of_pages,
    }
}

/// Free 4 KiB pages reported by the firmware (EfiConventionalMemory only).
fn free_pages() -> u64 {
    if !boot_services_done {
        read_memory_map()
    }
    let mut pages: u64 = 0
    for i in 0..memory_map_entries() {
        let r = memory_region(i)
        if r.kind == mem_conventional {
            pages += r.pages
        }
    }
    return pages
}

/// Byte `i` of a string (bounds checked).
fn str_byte(s: Str, i: usize) -> u8 {
    if i >= s.len() {
        panic("str_byte: index out of bounds")
    }
    return s.as_ptr().add(i).read()
}

/// Current date and time from the firmware clock.
fn now() -> Time {
    let mut t: Time
    let rt = (*st).runtime_services
    (*rt).get_time(&mut t as *mut Time, 0 as *mut u8)
    return t
}

/// Copies the firmware vendor name (UTF-16) as ASCII, returns its length.
fn firmware_vendor(buf: &mut [u8]) -> usize {
    let name = (*st).firmware_vendor
    if name.is_null() {
        return 0
    }
    let mut n: usize = 0
    while n < buf.len() {
        let c = name.add(n).read()
        if c == 0 {
            break
        }
        if c < 128 {
            buf[n] = c as u8
        } else {
            buf[n] = '?'
        }
        n += 1
    }
    return n
}

/// UEFI revision: major in the high 16 bits, minor * 10 in the low bits.
fn uefi_revision() -> u32 {
    return (*st).hdr.revision
}

/// Restarts the machine.
fn reboot() {
    let rt = (*st).runtime_services
    (*rt).reset_system(reset_cold, 0, 0, 0 as *const u8)
}

/// Powers the machine off.
fn shutdown() {
    let rt = (*st).runtime_services
    (*rt).reset_system(reset_shutdown, 0, 0, 0 as *const u8)
}
