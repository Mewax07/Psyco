/// Wiki Doc sources:
///   - https://wiki.osdev.org/Page_Frame_Allocation
///   - https://wiki.osdev.org/Writing_A_Page_Frame_Allocator
///   - https://wiki.osdev.org/Detecting_Memory_(x86)

import "efi.psy"
import "sync.psy"

const page_size: u64 = 4096
const page_shift: u64 = 12

const pmm_max_pages: u64 = 4194304
const pmm_words: usize = 65536
const bits_per_word: u64 = 64
const full_word: u64 = 0xFFFFFFFFFFFFFFFF

const pmm_reserved_low: u64 = 0x100000

static mut pmm_bitmap: [u64; 65536]

static mut pmm_hint: u64 = 0

#[getter]
static mut pmm_total_pages: u64 = 0
#[getter]
static mut pmm_free_pages: u64 = 0
#[getter]
static mut pmm_ignored_pages: u64 = 0
#[getter]
static mut pmm_ready: bool = false

fn page_used(index: u64) -> bool {
    return (pmm_bitmap[(index / bits_per_word) as usize] >> (index % bits_per_word)) & 1 == 1
}

fn mark_used(index: u64) {
    let w = (index / bits_per_word) as usize
    pmm_bitmap[w] |= 1u64 << (index % bits_per_word)
}

fn mark_free(index: u64) {
    let w = (index / bits_per_word) as usize
    pmm_bitmap[w] &= ~(1u64 << (index % bits_per_word))
}

fn page_index(addr: u64) -> u64 {
    if addr % page_size != 0 {
        panic("pmm: address is not page aligned")
    }
    let index = addr >> page_shift
    if index >= pmm_max_pages {
        panic("pmm: address beyond the tracked memory")
    }
    return index
}

fn pmm_init() {
    for i in 0..pmm_words {
        pmm_bitmap[i] = full_word
    }
    pmm_total_pages = 0
    pmm_free_pages = 0
    pmm_ignored_pages = 0
    for i in 0..memory_map_entries() {
        let r = memory_region(i)
        if r.kind == mem_conventional {
            pmm_add_region(r.start, r.pages)
        }
    }
    pmm_hint = pmm_reserved_low >> page_shift
    pmm_ready = true
}

fn pmm_add_region(start: u64, pages: u64) {
    for p in 0..pages {
        let addr = start + p * page_size
        if addr < pmm_reserved_low {
            continue
        }
        let index = addr >> page_shift
        if index >= pmm_max_pages {
            pmm_ignored_pages += 1
            continue
        }
        if page_used(index) {
            mark_free(index)
            pmm_total_pages += 1
            pmm_free_pages += 1
        }
    }
}

fn pmm_release_region(start: u64, pages: u64) -> u64 {
    let was_on = irq_save()
    let result = pmm_release_region_locked(start, pages)
    irq_restore(was_on)
    return result
}

fn pmm_release_region_locked(start: u64, pages: u64) -> u64 {
    let before = pmm_free_pages
    pmm_add_region(start, pages)
    let index = start >> page_shift
    if index < pmm_hint {
        pmm_hint = index
    }
    if pmm_hint < (pmm_reserved_low >> page_shift) {
        pmm_hint = pmm_reserved_low >> page_shift
    }
    return pmm_free_pages - before
}

fn pmm_alloc_page() -> u64 {
    let was_on = irq_save()
    let result = pmm_alloc_page_locked()
    irq_restore(was_on)
    return result
}

fn pmm_alloc_page_locked() -> u64 {
    let mut w = (pmm_hint / bits_per_word) as usize
    while w < pmm_words {
        let word = pmm_bitmap[w]
        if word != full_word {
            for b in 0..bits_per_word {
                if (word >> b) & 1 == 0 {
                    let index = w as u64 * bits_per_word + b
                    mark_used(index)
                    pmm_free_pages -= 1
                    pmm_hint = index + 1
                    return index << page_shift
                }
            }
        }
        w += 1
    }
    pmm_hint = pmm_max_pages
    return 0
}

fn pmm_alloc_pages(count: u64) -> u64 {
    let was_on = irq_save()
    let result = pmm_alloc_pages_locked(count)
    irq_restore(was_on)
    return result
}

fn pmm_alloc_pages_locked(count: u64) -> u64 {
    if count == 0 {
        return 0
    }
    if count == 1 {
        return pmm_alloc_page()
    }
    let mut start = pmm_hint
    let mut run: u64 = 0
    let mut index = pmm_hint
    while index < pmm_max_pages {
        if index % bits_per_word == 0 && pmm_bitmap[(index / bits_per_word) as usize] == full_word {
            index += bits_per_word
            run = 0
            continue
        }
        if page_used(index) {
            run = 0
        } else {
            if run == 0 {
                start = index
            }
            run += 1
            if run == count {
                for i in start..start + count {
                    mark_used(i)
                }
                pmm_free_pages -= count
                if start == pmm_hint {
                    pmm_hint = start + count
                }
                return start << page_shift
            }
        }
        index += 1
    }
    return 0
}

fn pmm_free_page(addr: u64) {
    let was_on = irq_save()
    pmm_free_page_locked(addr)
    irq_restore(was_on)
}

fn pmm_free_page_locked(addr: u64) {
    let index = page_index(addr)
    if !page_used(index) {
        panic("pmm_free_page: page already free")
    }
    if addr < pmm_reserved_low {
        panic("pmm_free_page: reserved page")
    }
    mark_free(index)
    pmm_free_pages += 1
    if index < pmm_hint {
        pmm_hint = index
    }
}

fn pmm_free_pages_at(addr: u64, count: u64) {
    for i in 0..count {
        pmm_free_page(addr + i * page_size)
    }
}

fn pmm_is_used(addr: u64) -> bool {
    return page_used(page_index(addr))
}

fn pmm_reclaim_boot_services() -> u64 {
    let mut added: u64 = 0
    for i in 0..memory_map_entries() {
        let r = memory_region(i)
        if r.kind == mem_boot_services_code || r.kind == mem_boot_services_data {
            added += pmm_release_region(r.start, r.pages)
        }
    }
    return added
}
