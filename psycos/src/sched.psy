/// Wiki Doc sources:
///   - https://wiki.osdev.org/Scheduling_Algorithms
///   - https://wiki.osdev.org/Kernel_Multitasking
///   - https://wiki.osdev.org/Brendan%27s_Multi-tasking_Tutorial

import "context.psy"
import "paging.psy"
import "timer.psy"
import "sync.psy"
import "exceptions.psy"
import "keyboard.psy"
import "usermode.psy"
import "cpu.psy"

const max_tasks: usize = 32
const task_stack_pages: u64 = 4
const task_stack_size: u64 = 16384
const task_name_max: usize = 16

const stack_area_base: u64 = 0xFFFFE00000000000
const stack_window: u64 = 0x10000

const boot_task: usize = 0
const idle_task: usize = 1

const exit_fault_base: i64 = 128
const exit_killed: i64 = 137

const time_slice: u64 = 2
const stack_flush_pages: u64 = 4

enum TaskState: u8 {
    Free,
    Ready,
    Running,
    Sleeping,
    Dead,
    Blocked,
}

struct Task {
    id: u64,
    state: TaskState,
    rsp: u64,
    has_stack: bool,
    entry: fn(),
    name: [u8; 16],
    name_len: usize,
    wake_tick: u64,
    run_ticks: u64,
    switches: u64,
    cr3: u64,
    is_user: bool,
    user_entry: u64,
    user_stack: u64,
    exit_code: i64,
    cpu: usize,
    pinned: bool,
    lock_depth: u64,
}

static mut tasks: [Task; 32]
static mut current_of: [usize; 16]
static mut idle_of: [usize; 16]
static mut slice_of: [u64; 16]
static mut busy_of: [u64; 16]
#[getter]
static mut max_parallel_user: u64 = 0
#[getter]
static mut sched_ready: bool = false
#[getter]
static mut context_switches: u64 = 0
#[getter]
static mut preemptions: u64 = 0
static mut next_task_id: u64 = 0

static mut last_exit: [i64; 32]
static mut last_exit_id: [u64; 32]

fn cur() -> usize {
    return current_of[this_cpu()]
}

fn get_current() -> usize {
    return cur()
}

fn is_current_anywhere(slot: usize) -> bool {
    for c in 0..get_cpus_online() {
        if current_of[c] == slot {
            return true
        }
    }
    return false
}

fn is_idle(slot: usize) -> bool {
    for c in 0..get_cpus_online() {
        if idle_of[c] == slot {
            return true
        }
    }
    return false
}

fn task_set_name_bytes(slot: usize, name: &[u8]) {
    let mut n = name.len()
    if n > task_name_max {
        n = task_name_max
    }
    for i in 0..n {
        tasks[slot].name[i] = name[i]
    }
    tasks[slot].name_len = n
}

fn set_name(slot: usize, name: Str) {
    let mut n = name.len()
    if n > task_name_max {
        n = task_name_max
    }
    let bytes = name.as_bytes()
    for i in 0..n {
        tasks[slot].name[i] = bytes[i]
    }
    tasks[slot].name_len = n
}

fn init_slot(slot: usize, name: Str, state: TaskState) {
    tasks[slot].id = next_task_id
    next_task_id += 1
    tasks[slot].state = state
    tasks[slot].wake_tick = 0
    tasks[slot].run_ticks = 0
    tasks[slot].switches = 0
    tasks[slot].cr3 = kernel_root()
    tasks[slot].is_user = false
    tasks[slot].exit_code = 0
    tasks[slot].cpu = 0
    tasks[slot].pinned = false
    tasks[slot].lock_depth = 1
    set_name(slot, name)
}

fn idle_main() {
    loop {
        cli()
        reap()
        kernel_unlock_all()
        sti()
        hlt()
        cli()
        kernel_lock()
        schedule()
    }
}

fn wait_one_tick() {
    task_sleep(1)
}

fn sched_init() {
    for i in 0..max_tasks {
        tasks[i].state = TaskState::Free
        tasks[i].has_stack = false
    }
    next_task_id = 0
    kernel_lock()
    init_slot(boot_task, "kernel", TaskState::Running)
    tasks[boot_task].pinned = true
    current_of[0] = boot_task
    slice_of[0] = time_slice
    sched_ready = true
    set_tick_hook(sched_tick)
    set_user_fault_hook(user_fault)
    set_key_wait_hook(wait_one_tick)
    set_stack_guard_check(is_stack_guard)
    if spawn("idle", idle_main) != idle_task as i64 {
        panic("sched_init: idle task is not task 1")
    }
    tasks[idle_task].pinned = true
    idle_of[0] = idle_task
}

fn sched_add_cpu(cpu: usize) -> i64 {
    let was_on = irq_save()
    let mut slot = max_tasks
    for i in 0..max_tasks {
        if tasks[i].state == TaskState::Free {
            slot = i
            break
        }
    }
    if slot == max_tasks {
        irq_restore(was_on)
        return -1
    }
    tasks[slot].has_stack = false
    init_slot(slot, "idle", TaskState::Running)
    tasks[slot].cpu = cpu
    tasks[slot].pinned = true
    idle_of[cpu] = slot
    current_of[cpu] = slot
    slice_of[cpu] = time_slice
    irq_restore(was_on)
    return slot as i64
}

fn stack_top(slot: usize) -> u64 {
    return stack_area_base + (slot as u64 + 1) * stack_window
}

fn stack_map(slot: usize) -> bool {
    let bottom = stack_top(slot) - task_stack_size
    for i in 0..task_stack_pages {
        let phys = pmm_alloc_page()
        if phys == 0 {
            return false
        }
        map_page(bottom + i * size_4k, phys, 0)
    }
    return true
}

fn stack_unmap(slot: usize) {
    let bottom = stack_top(slot) - task_stack_size
    for i in 0..task_stack_pages {
        let va = bottom + i * size_4k
        let phys = translate(va)
        if phys != not_mapped {
            unmap_page(va)
            pmm_free_page(phys)
        }
    }
}

fn is_stack_guard(addr: u64) -> bool {
    if addr < stack_area_base || addr >= stack_area_base + max_tasks as u64 * stack_window {
        return false
    }
    let offset = (addr - stack_area_base) % stack_window
    return offset < stack_window - task_stack_size
}

fn sched_drop_cpu(slot: usize) {
    tasks[slot].state = TaskState::Free
}

fn reap() {
    for i in 0..max_tasks {
        if !is_current_anywhere(i) && tasks[i].state == TaskState::Dead {
            if tasks[i].is_user {
                as_destroy(tasks[i].cr3)
                tasks[i].is_user = false
            }
            if tasks[i].has_stack {
                stack_unmap(i)
                tasks[i].has_stack = false
            }
            tasks[i].state = TaskState::Free
        }
    }
}

fn task_start() {
    kernel_lock_resume(1)
    sti()
    let entry = tasks[cur()].entry
    entry()
    task_exit()
}

fn user_task_start() {
    let slot = cur()
    cli()
    kernel_unlock_all()
    enter_user(tasks[slot].user_entry, tasks[slot].user_stack)
}

fn cpu_load(c: usize) -> u64 {
    let mut n: u64 = 0
    for i in 0..max_tasks {
        let st = tasks[i].state
        if tasks[i].cpu == c && !is_idle(i) && st != TaskState::Free && st != TaskState::Dead {
            n += 1
        }
    }
    return n
}

fn least_loaded_cpu() -> usize {
    let mut best: usize = 0
    let mut best_load = cpu_load(0)
    for c in 1..get_cpus_online() {
        let l = cpu_load(c)
        if l < best_load {
            best = c
            best_load = l
        }
    }
    return best
}

fn spawn_user(name: Str, root: u64, entry: u64, stack: u64) -> i64 {
    let was_on = irq_save()
    let slot = spawn(name, user_task_start)
    if slot >= 0 {
        let s = slot as usize
        tasks[s].cr3 = root
        tasks[s].is_user = true
        tasks[s].user_entry = entry
        tasks[s].user_stack = stack
    }
    irq_restore(was_on)
    return slot
}

fn spawn(name: Str, entry: fn()) -> i64 {
    let was_on = irq_save()
    reap()
    let mut slot = max_tasks
    for i in 0..max_tasks {
        if tasks[i].state == TaskState::Free {
            slot = i
            break
        }
    }
    if slot == max_tasks {
        irq_restore(was_on)
        return -1
    }
    if !stack_map(slot) {
        stack_unmap(slot)
        irq_restore(was_on)
        return -1
    }
    tasks[slot].has_stack = true
    tasks[slot].entry = entry
    tasks[slot].rsp = context_new(stack_top(slot), task_start)
    init_slot(slot, name, TaskState::Ready)
    tasks[slot].cpu = least_loaded_cpu()
    cpu_kick(tasks[slot].cpu)
    irq_restore(was_on)
    return slot as i64
}

fn runnable_on(slot: usize, c: usize) -> bool {
    if tasks[slot].state == TaskState::Ready {
        return true
    }
    return tasks[slot].state == TaskState::Running && current_of[c] == slot
}

fn task_run_ticks(slot: usize) -> u64 {
    return tasks[slot].run_ticks
}

fn pick_next(c: usize) -> usize {
    let me = current_of[c]
    for step in 1..max_tasks + 1 {
        let i = (me + step) % max_tasks
        if tasks[i].cpu == c && !is_idle(i) && runnable_on(i, c) {
            return i
        }
    }
    for i in 0..max_tasks {
        if tasks[i].cpu != c && !tasks[i].pinned && !is_idle(i) && tasks[i].state == TaskState::Ready && !is_idle(current_of[tasks[i].cpu]) {
            return i
        }
    }
    return idle_of[c]
}

fn flush_stack(slot: usize) {
    let bottom = stack_top(slot) - task_stack_size
    for i in 0..stack_flush_pages {
        invlpg((bottom + i * size_4k) as usize)
    }
}

fn schedule() {
    if !sched_ready {
        return
    }
    let c = this_cpu()
    let prev = current_of[c]
    let next = pick_next(c)
    if next == prev {
        return
    }
    if tasks[prev].state == TaskState::Running {
        tasks[prev].state = TaskState::Ready
    }
    tasks[next].state = TaskState::Running
    tasks[next].cpu = c
    tasks[next].switches += 1
    slice_of[c] = time_slice
    context_switches += 1
    current_of[c] = next
    if tasks[next].has_stack {
        set_kernel_entry_stack(c, stack_top(next))
        flush_stack(next)
    }
    if tasks[next].cr3 != tasks[prev].cr3 {
        switch_address_space(tasks[next].cr3)
    }
    tasks[prev].lock_depth = get_big_depth()
    context_switch_to(&mut tasks[prev].rsp as *mut u64, tasks[next].rsp)
    kernel_lock_resume(tasks[cur()].lock_depth)
}

fn count_parallel_user() {
    let mut n: u64 = 0
    for c in 0..get_cpus_online() {
        if tasks[current_of[c]].is_user && tasks[current_of[c]].state == TaskState::Running {
            n += 1
        }
    }
    if n > max_parallel_user {
        max_parallel_user = n
    }
}

fn cpu_busy_ticks(c: usize) -> u64 {
    return busy_of[c]
}

fn sched_tick() {
    let now = get_ticks()
    for i in 0..max_tasks {
        if tasks[i].state == TaskState::Sleeping && now >= tasks[i].wake_tick {
            tasks[i].state = TaskState::Ready
        }
        if tasks[i].state == TaskState::Blocked && tasks[i].wake_tick != 0 && now >= tasks[i].wake_tick {
            tasks[i].state = TaskState::Ready
        }
    }
    let c = this_cpu()
    let me = current_of[c]
    tasks[me].run_ticks += 1
    if !is_idle(me) {
        busy_of[c] += 1
    }
    count_parallel_user()
    if slice_of[c] > 0 {
        slice_of[c] -= 1
    }
    let gone = tasks[me].state == TaskState::Dead
    if slice_of[c] == 0 || gone || (is_idle(me) && pick_next(c) != me) {
        slice_of[c] = time_slice
        if pick_next(c) != me && !is_idle(me) {
            preemptions += 1
        }
        schedule()
    }
}

fn task_sleep(ms: u64) {
    let was_on = irq_save()
    tasks[cur()].wake_tick = get_ticks() + (ms * timer_hz + 999) / 1000
    tasks[cur()].state = TaskState::Sleeping
    schedule()
    irq_restore(was_on)
}

fn task_kill(slot: usize) -> bool {
    if slot >= max_tasks || slot == boot_task || slot == idle_task {
        return false
    }
    let was_on = irq_save()
    let state = tasks[slot].state
    if state == TaskState::Free || state == TaskState::Dead {
        irq_restore(was_on)
        return false
    }
    tasks[slot].exit_code = exit_killed
    if slot == cur() {
        task_exit()
    }
    last_exit[slot] = exit_killed
    last_exit_id[slot] = tasks[slot].id
    tasks[slot].state = TaskState::Dead
    irq_restore(was_on)
    return true
}

fn task_block() {
    tasks[cur()].wake_tick = 0
    tasks[cur()].state = TaskState::Blocked
    schedule()
}

fn task_block_until(tick: u64) {
    tasks[cur()].wake_tick = tick
    tasks[cur()].state = TaskState::Blocked
    schedule()
    tasks[cur()].wake_tick = 0
}

fn ms_to_ticks(ms: u64) -> u64 {
    return (ms * timer_hz + 999) / 1000
}

fn task_alive(id: u64) -> bool {
    return task_slot_of(id) >= 0
}

fn task_wake(slot: usize) {
    if slot < max_tasks && tasks[slot].state == TaskState::Blocked {
        tasks[slot].state = TaskState::Ready
        cpu_kick(tasks[slot].cpu)
    }
}

fn task_slot_of(id: u64) -> i64 {
    for i in 0..max_tasks {
        let state = tasks[i].state
        if tasks[i].id == id && state != TaskState::Free && state != TaskState::Dead {
            return i as i64
        }
    }
    return -1
}

fn yield_now() {
    let was_on = irq_save()
    schedule()
    irq_restore(was_on)
}

fn task_exit_code(code: i64) {
    cli()
    tasks[cur()].exit_code = code
    task_exit()
}

fn user_fault(vector: u64, rip: u64, addr: u64) {
    kernel_lock()
    puts("[")
    put_u64(tasks[cur()].id)
    puts("] killed: ")
    puts(exception_name(vector))
    puts(" at rip 0x")
    put_hex(rip)
    if vector == vector_page_fault {
        puts(", address 0x")
        put_hex(addr)
    }
    putc('\n')
    task_exit_code(exit_fault_base + vector as i64)
}

fn task_wait(slot: usize, id: u64) -> i64 {
    loop {
        let was_on = irq_save()
        let alive = tasks[slot].id == id && tasks[slot].state != TaskState::Free && tasks[slot].state != TaskState::Dead
        irq_restore(was_on)
        if !alive {
            break
        }
        task_sleep(10)
    }
    if tasks[slot].id == id && tasks[slot].state == TaskState::Dead {
        return tasks[slot].exit_code
    }
    if last_exit_id[slot] == id {
        return last_exit[slot]
    }
    return -1
}

fn task_exit() {
    cli()
    let me = cur()
    last_exit[me] = tasks[me].exit_code
    last_exit_id[me] = tasks[me].id
    tasks[cur()].state = TaskState::Dead
    schedule()
    panic("task_exit: a dead task was scheduled")
}

fn task_count() -> usize {
    let mut n: usize = 0
    for i in 0..max_tasks {
        if tasks[i].state != TaskState::Free && tasks[i].state != TaskState::Dead {
            n += 1
        }
    }
    return n
}

fn task_state(slot: usize) -> TaskState {
    return tasks[slot].state
}

fn task_id(slot: usize) -> u64 {
    return tasks[slot].id
}

fn task_name(slot: usize, buf: &mut [u8]) -> usize {
    let mut n = tasks[slot].name_len
    if n > buf.len() {
        n = buf.len()
    }
    for i in 0..n {
        buf[i] = tasks[slot].name[i]
    }
    return n
}

fn state_name(state: TaskState) -> Str {
    match state {
        TaskState::Free => return "free",
        TaskState::Ready => return "ready",
        TaskState::Running => return "running",
        TaskState::Sleeping => return "sleeping",
        TaskState::Dead => return "dead",
        TaskState::Blocked => return "blocked",
    }
}

fn current_task_id() -> u64 {
    return tasks[cur()].id
}

fn task_is_user(slot: usize) -> bool {
    return tasks[slot].is_user
}

fn task_cpu(slot: usize) -> usize {
    return tasks[slot].cpu
}

fn task_switches(slot: usize) -> u64 {
    return tasks[slot].switches
}
