/// Wiki Doc sources:
///   - https://wiki.osdev.org/Paging
///   - https://wiki.osdev.org/Identity_Paging
///   - https://wiki.osdev.org/Higher_Half_Kernel
///   - https://wiki.osdev.org/X86_Page_Tables

#![trusted]

import "efi.psy"
import "bytes.psy"
import "fb.psy"
import "pmm.psy"
import "stack.psy"

const kernel_virt_base: u64 = 0xFFFFFFFF80000000
const direct_map_base: u64 = 0xFFFF800000000000

const pte_present: u64 = 0x1
const pte_writable: u64 = 0x2
const pte_user: u64 = 0x4
const pte_huge: u64 = 0x80
const pte_global: u64 = 0x100
const pte_shared: u64 = 0x200
const pte_addr_mask: u64 = 0x000FFFFFFFFFF000

const entries_per_table: u64 = 512
const size_4k: u64 = 0x1000
const size_2m: u64 = 0x200000
const size_1g: u64 = 0x40000000

const identity_min: u64 = 0x100000000
const identity_max: u64 = 0x8000000000

const mem_first_ram_kind: u32 = 1
const mem_last_ram_kind: u32 = 10
const mem_persistent: u32 = 14

const pml4_identity_slot: usize = 0
const pml4_direct_map_slot: usize = 256

const not_mapped: u64 = 0xFFFFFFFFFFFFFFFF

#[getter]
static mut pml4_phys: u64 = 0
#[getter]
static mut identity_limit: u64 = 0
#[getter]
static mut table_pages: u64 = 0
#[getter]
static mut paging_ready: bool = false

fn phys_ptr(phys: u64) -> *mut u64 {
    if paging_ready {
        return (direct_map_base + phys) as *mut u64
    }
    return phys as *mut u64
}

fn new_table() -> u64 {
    let page = pmm_alloc_page()
    if page == 0 {
        panic("paging: out of memory for page tables")
    }
    memset(phys_ptr(page) as *mut u8, 0, size_4k as usize)
    table_pages += 1
    return page
}

fn free_table(table: u64) {
    pmm_free_page(table)
    table_pages -= 1
}

fn entry(table: u64, index: u64) -> *mut u64 {
    return phys_ptr(table).add(index as usize)
}

fn table_index(virt: u64, level: u64) -> u64 {
    return (virt >> (12 + 9 * level)) & (entries_per_table - 1)
}

fn next_table(table: u64, index: u64, create: bool, user: bool) -> u64 {
    let e = entry(table, index)
    let value = e.read()
    if value & pte_present == 0 {
        if !create {
            return 0
        }
        let t = new_table()
        let mut flags = pte_present | pte_writable
        if user {
            flags |= pte_user
        }
        e.write(t | flags)
        return t
    }
    if value & pte_huge != 0 {
        return 0
    }
    if user && value & pte_user == 0 {
        e.write(value | pte_user)
    }
    return value & pte_addr_mask
}

fn flush(root: u64, virt: u64) {
    if paging_ready && read_cr3() == root {
        invlpg(virt as usize)
    }
}

fn map_page_in(root: u64, virt: u64, phys: u64, flags: u64) -> bool {
    if virt % size_4k != 0 || phys % size_4k != 0 {
        panic("map_page: unaligned address")
    }
    let user = flags & pte_user != 0
    let pdpt = next_table(root, table_index(virt, 3), true, user)
    let pd = next_table(pdpt, table_index(virt, 2), true, user)
    if pd == 0 {
        return false
    }
    let pt = next_table(pd, table_index(virt, 1), true, user)
    if pt == 0 {
        return false
    }
    entry(pt, table_index(virt, 0)).write(phys | flags | pte_present)
    flush(root, virt)
    return true
}

fn map_page(virt: u64, phys: u64, flags: u64) -> bool {
    return map_page_in(pml4_phys, virt, phys, flags | pte_writable)
}

fn leaf_entry(root: u64, virt: u64) -> *mut u64 {
    let pdpt = next_table(root, table_index(virt, 3), false, false)
    if pdpt == 0 {
        return 0 as *mut u64
    }
    let pd = next_table(pdpt, table_index(virt, 2), false, false)
    if pd == 0 {
        return 0 as *mut u64
    }
    let pt = next_table(pd, table_index(virt, 1), false, false)
    if pt == 0 {
        return 0 as *mut u64
    }
    return entry(pt, table_index(virt, 0))
}

fn unmap_page_in(root: u64, virt: u64) -> bool {
    let e = leaf_entry(root, virt)
    if e.is_null() || e.read() & pte_present == 0 {
        return false
    }
    e.write(0)
    flush(root, virt)
    return true
}

fn unmap_page(virt: u64) -> bool {
    return unmap_page_in(pml4_phys, virt)
}

fn translate_in(root: u64, virt: u64) -> u64 {
    let mut table = root
    let mut level: u64 = 3
    loop {
        let value = entry(table, table_index(virt, level)).read()
        if value & pte_present == 0 {
            return not_mapped
        }
        let page_bits = 12 + 9 * level
        if level == 0 || value & pte_huge != 0 {
            let offset_mask = (1u64 << page_bits) - 1
            return (value & pte_addr_mask & ~offset_mask) | (virt & offset_mask)
        }
        table = value & pte_addr_mask
        level -= 1
    }
}

fn translate(virt: u64) -> u64 {
    return translate_in(pml4_phys, virt)
}

fn user_page_ok(root: u64, virt: u64, write: bool) -> bool {
    let mut table = root
    let mut level: u64 = 3
    loop {
        let value = entry(table, table_index(virt, level)).read()
        if value & pte_present == 0 || value & pte_user == 0 {
            return false
        }
        if write && value & pte_writable == 0 {
            return false
        }
        if level == 0 || value & pte_huge != 0 {
            return true
        }
        table = value & pte_addr_mask
        level -= 1
    }
}

fn as_create() -> u64 {
    let root = new_table()
    for i in pml4_direct_map_slot as u64..entries_per_table {
        entry(root, i).write(entry(pml4_phys, i).read())
    }
    return root
}

fn as_destroy(root: u64) {
    if root == pml4_phys || root == read_cr3() {
        panic("as_destroy: address space still in use")
    }
    for i in 0..pml4_direct_map_slot as u64 {
        let pdpt = next_table(root, i, false, false)
        if pdpt == 0 {
            continue
        }
        for j in 0..entries_per_table {
            let pd = next_table(pdpt, j, false, false)
            if pd == 0 {
                continue
            }
            for k in 0..entries_per_table {
                let pt = next_table(pd, k, false, false)
                if pt == 0 {
                    continue
                }
                for l in 0..entries_per_table {
                    let value = entry(pt, l).read()
                    if value & pte_present != 0 && value & pte_shared == 0 {
                        pmm_free_page(value & pte_addr_mask)
                    }
                }
                free_table(pt)
            }
            free_table(pd)
        }
        free_table(pdpt)
    }
    free_table(root)
}

fn physical_limit() -> u64 {
    let mut limit = identity_min
    for i in 0..memory_map_entries() {
        let r = memory_region(i)
        let ram_like = (r.kind >= mem_first_ram_kind && r.kind <= mem_last_ram_kind) || r.kind == mem_persistent
        if !ram_like {
            continue
        }
        let end = r.start + r.pages * size_4k
        if end > limit {
            limit = end
        }
    }
    let fb_end = get_fb_base() as u64 + get_fb_size() as u64
    if fb_end > limit {
        limit = fb_end
    }
    limit = (limit + size_1g - 1) / size_1g * size_1g
    if limit > identity_max {
        limit = identity_max
    }
    return limit
}

fn kernel_root() -> u64 {
    return pml4_phys
}

fn paging_init() {
    pml4_phys = new_table()

    identity_limit = physical_limit()
    let pdpt = new_table()
    for gib in 0..identity_limit / size_1g {
        let pd = new_table()
        entry(pdpt, gib).write(pd | pte_present | pte_writable)
        for i in 0..entries_per_table {
            let phys = gib * size_1g + i * size_2m
            entry(pd, i).write(phys | pte_present | pte_writable | pte_huge)
        }
    }
    entry(pml4_phys, pml4_identity_slot as u64).write(pdpt | pte_present | pte_writable)
    entry(pml4_phys, pml4_direct_map_slot as u64).write(pdpt | pte_present | pte_writable)

    let pages = pages_for(get_image_size())
    for p in 0..pages {
        let offset = p * size_4k
        map_page(kernel_virt_base + offset, get_image_base() + offset, 0)
    }

    write_cr3(pml4_phys)
    paging_ready = true

    let fb = get_fb_base() as u64
    if fb != 0 && fb + get_fb_size() as u64 <= identity_limit {
        fb_move(direct_map_base + fb)
    }
    let back = fb_back_phys()
    if back != 0 && back + get_fb_size() as u64 <= identity_limit {
        fb_move_back(direct_map_base + back)
    }
}

fn kernel_high(addr: u64) -> u64 {
    let base = get_image_base()
    if addr >= kernel_virt_base {
        return addr
    }
    if addr < base || addr >= base + get_image_size() {
        panic("kernel_high: address outside the kernel image")
    }
    return addr - base + kernel_virt_base
}

fn rebase_kernel_statics() {
    rebase_statics(kernel_virt_base - get_image_base())
}

fn zero_phys(phys: u64, bytes: u64) {
    memset(phys_to_virt(phys) as *mut u8, 0, bytes as usize)
}

fn phys_to_virt(phys: u64) -> u64 {
    return direct_map_base + phys
}

fn enter_higher_half(entry: fn()) {
    if !paging_ready {
        panic("enter_higher_half: paging is not set up")
    }
    memset(kstack.as_mut_ptr(), kstack_fill, kstack_size)
    let top = kernel_high(kstack_top() as u64)
    let high_entry = kernel_high(entry as u64) as fn()
    switch_stack(top as usize, high_entry)
}
