const sys_cpu: u64 = 0x100A

const sys_map: u64 = 0x1010
const sys_unmap: u64 = 0x1011
const sys_mem_pages: u64 = 0x1012

const sys_port_create: u64 = 0x1020
const sys_port_destroy: u64 = 0x1021
