/// Wiki Doc sources:
///   - https://man7.org/linux/man-pages/man2/write.2.html

const sys_write: u64 = 1
const stdout: u64 = 1
const kernel_image: u64 = 0xFFFFFFFF80000000
const unmapped: u64 = 0x10000000

fn main() {
    print("kernel pointer:", syscall(sys_write, stdout, kernel_image, 16))
    print("unmapped pointer:", syscall(sys_write, stdout, unmapped, 16))
    print("bad fd:", syscall(sys_write, 7, unmapped, 16))
    print("unknown syscall:", syscall(1000, 0, 0, 0))
}
