/// Wiki Doc sources:
///   - https://man7.org/linux/man-pages/man2/sched_yield.2.html

const report_every: u64 = 500000000

fn main() {
    let mut n: u64 = 0
    print("spinning forever (stop it with kill)")
    loop {
        n = n +% 1
        if n % report_every == 0 {
            print("still spinning")
        }
    }
}
