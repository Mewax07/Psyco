/// Wiki Doc sources:
///   - https://wiki.osdev.org/Memory_Allocation
///   - https://doc.rust-lang.org/std/vec/struct.Vec.html

#![trusted]

mod std_heap {
    fn new(size: usize) -> *mut u8 {
        let mut n = size
        if n == 0 {
            n = 1
        }
        let p = psy_alloc(n)
        if p.is_null() {
            panic("out of memory")
        }
        return p
    }

    fn check(ptr: *mut u8, generation: u64, bytes: usize) {
        if generation == 0 || psy_generation(ptr) != generation {
            panic("heap memory used after free")
        }
        if bytes > psy_capacity(ptr) {
            panic("index out of bounds")
        }
    }

    fn elem_size(size: usize) -> usize {
        if size == 0 {
            return 1
        }
        return size
    }
}

#[move]
struct Box<T> {
    ptr: *mut T,
    generation: u64,
}

impl<T> Box<T> {
    fn new(value: T) -> Box<T> {
        let p = std_heap::new(sizeof(T)) as *mut T
        p.write(value)
        return Box { ptr: p, generation: psy_generation(p as *mut u8) }
    }

    fn as_ref(&self) -> &T {
        std_heap::check(self.ptr as *mut u8, self.generation, sizeof(T))
        return &*self.ptr
    }

    fn as_mut(&mut self) -> &mut T {
        std_heap::check(self.ptr as *mut u8, self.generation, sizeof(T))
        return &mut *self.ptr
    }

    fn into_inner(self) -> T {
        std_heap::check(self.ptr as *mut u8, self.generation, sizeof(T))
        let v = self.ptr.read()
        psy_free(self.ptr as *mut u8)
        return v
    }

    fn free(self) {
        std_heap::check(self.ptr as *mut u8, self.generation, sizeof(T))
        psy_free(self.ptr as *mut u8)
    }
}

impl<T: Copy> Box<T> {
    fn get(&self) -> T {
        return *self.as_ref()
    }

    fn set(&mut self, value: T) {
        *self.as_mut() = value
    }
}

#[move]
struct Vec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
    generation: u64,
}

impl<T> Vec<T> {
    fn new() -> Vec<T> {
        return Vec { ptr: 0 as *mut T, len: 0, cap: 0, generation: 0 }
    }

    fn with_capacity(n: usize) -> Vec<T> {
        let mut v = Vec { ptr: 0 as *mut T, len: 0, cap: 0, generation: 0 }
        v.reserve(n)
        return v
    }

    fn len(&self) -> usize {
        return self.len
    }

    fn is_empty(&self) -> bool {
        return self.len == 0
    }

    fn capacity(&self) -> usize {
        return self.cap
    }

    fn check(&self, n: usize) {
        if n > 0 {
            std_heap::check(self.ptr as *mut u8, self.generation, n * std_heap::elem_size(sizeof(T)))
        }
    }

    fn reserve(&mut self, extra: usize) {
        let need = self.len + extra
        if need <= self.cap {
            return
        }
        let mut cap = self.cap * 2
        if cap < need {
            cap = need
        }
        if cap < 4 {
            cap = 4
        }
        let size = std_heap::elem_size(sizeof(T))
        let p = std_heap::new(cap * size)
        if self.cap > 0 {
            self.check(self.len)
            memcpy(p, self.ptr as *const u8, self.len * size)
            psy_free(self.ptr as *mut u8)
        }
        self.ptr = p as *mut T
        self.cap = cap
        self.generation = psy_generation(p)
    }

    fn push(&mut self, value: T) {
        self.reserve(1)
        self.check(self.len + 1)
        self.ptr.add(self.len).write(value)
        self.len += 1
    }

    fn pop(&mut self) -> Option<T> {
        if self.len == 0 {
            return None
        }
        self.check(self.len)
        self.len -= 1
        return Some(self.ptr.add(self.len).read())
    }

    fn at(&self, i: usize) -> &T {
        if i >= self.len {
            panic("index out of bounds")
        }
        self.check(i + 1)
        return &*self.ptr.add(i)
    }

    fn at_mut(&mut self, i: usize) -> &mut T {
        if i >= self.len {
            panic("index out of bounds")
        }
        self.check(i + 1)
        return &mut *self.ptr.add(i)
    }

    fn insert(&mut self, i: usize, value: T) {
        if i > self.len {
            panic("insert index out of bounds")
        }
        self.reserve(1)
        self.check(self.len + 1)
        let size = std_heap::elem_size(sizeof(T))
        let mut k = self.len
        while k > i {
            memcpy(self.ptr.add(k) as *mut u8, self.ptr.add(k - 1) as *const u8, size)
            k -= 1
        }
        self.ptr.add(i).write(value)
        self.len += 1
    }

    fn remove(&mut self, i: usize) -> T {
        if i >= self.len {
            panic("remove index out of bounds")
        }
        self.check(self.len)
        let v = self.ptr.add(i).read()
        let size = std_heap::elem_size(sizeof(T))
        for k in i..self.len - 1 {
            memcpy(self.ptr.add(k) as *mut u8, self.ptr.add(k + 1) as *const u8, size)
        }
        self.len -= 1
        return v
    }

    fn truncate(&mut self, n: usize) {
        if n < self.len {
            self.len = n
        }
    }

    fn clear(&mut self) {
        self.len = 0
    }

    fn as_slice(&self) -> &[T] {
        self.check(self.len)
        return slice_from_raw(self.ptr as *const T, self.len)
    }

    fn as_mut_slice(&mut self) -> &mut [T] {
        self.check(self.len)
        return slice_from_raw_mut(self.ptr, self.len)
    }

    fn free(self) {
        if self.cap > 0 {
            self.check(1)
            psy_free(self.ptr as *mut u8)
        }
    }
}

impl<T: Copy> Vec<T> {
    fn zeroed(n: usize) -> Vec<T> {
        let mut v = Vec { ptr: 0 as *mut T, len: 0, cap: 0, generation: 0 }
        v.reserve(n)
        v.len = n
        return v
    }

    fn from_slice(items: &[T]) -> Vec<T> {
        let mut v = Vec { ptr: 0 as *mut T, len: 0, cap: 0, generation: 0 }
        v.extend_from_slice(items)
        return v
    }

    fn get(&self, i: usize) -> T {
        return *self.at(i)
    }

    fn set(&mut self, i: usize, value: T) {
        *self.at_mut(i) = value
    }

    fn extend_from_slice(&mut self, items: &[T]) {
        self.reserve(items.len())
        self.check(self.len + items.len())
        let size = std_heap::elem_size(sizeof(T))
        if items.len() > 0 {
            memcpy(self.ptr.add(self.len) as *mut u8, items.as_ptr() as *const u8, items.len() * size)
        }
        self.len += items.len()
    }

    fn copy_from(&mut self, at: usize, items: &[T]) {
        if at > self.len || items.len() > self.len - at {
            panic("copy out of bounds")
        }
        self.check(self.len)
        if items.len() > 0 {
            memcpy(self.ptr.add(at) as *mut u8, items.as_ptr() as *const u8, items.len() * std_heap::elem_size(sizeof(T)))
        }
    }

    fn fill(&mut self, value: T) {
        for i in 0..self.len {
            self.set(i, value)
        }
    }
}

#[move]
struct String {
    bytes: Vec<u8>,
}

impl String {
    fn new() -> String {
        return String { bytes: Vec::new() }
    }

    fn from(s: Str) -> String {
        let mut out = String::new()
        out.push_str(s)
        return out
    }

    fn len(&self) -> usize {
        return self.bytes.len()
    }

    fn is_empty(&self) -> bool {
        return self.bytes.len() == 0
    }

    fn byte(&self, i: usize) -> u8 {
        return self.bytes.get(i)
    }

    fn push(&mut self, c: u8) {
        self.bytes.push(c)
    }

    fn push_str(&mut self, s: Str) {
        self.bytes.extend_from_slice(s.as_bytes())
    }

    fn push_bytes(&mut self, b: &[u8]) {
        self.bytes.extend_from_slice(b)
    }

    fn push_u64(&mut self, n: u64) {
        let mut digits = [0u8; 20]
        let mut count: usize = 0
        let mut v = n
        loop {
            digits[count] = '0' + (v % 10) as u8
            count += 1
            v = v / 10
            if v == 0 {
                break
            }
        }
        while count > 0 {
            count -= 1
            self.bytes.push(digits[count])
        }
    }

    fn as_bytes(&self) -> &[u8] {
        return self.bytes.as_slice()
    }

    fn eq_str(&self, s: Str) -> bool {
        let b = s.as_bytes()
        if b.len() != self.bytes.len() {
            return false
        }
        for i in 0..b.len() {
            if self.bytes.get(i) != b[i] {
                return false
            }
        }
        return true
    }

    fn clear(&mut self) {
        self.bytes.clear()
    }

    fn free(self) {
        self.bytes.free()
    }
}
