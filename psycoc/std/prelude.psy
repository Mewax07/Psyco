enum Option<T> {
    None,
    Some(T),
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T> Option<T> {
    fn is_some(self) -> bool {
        if let Some(_) = self {
            return true
        }
        return false
    }

    fn is_none(self) -> bool {
        if let Some(_) = self {
            return false
        }
        return true
    }

    fn unwrap(self) -> T {
        match self {
            Some(v) => return v,
            None => panic("called unwrap() on None"),
        }
    }

    fn expect(self, msg: Str) -> T {
        match self {
            Some(v) => return v,
            None => panic(msg),
        }
    }

    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Some(v) => return v,
            None => return fallback,
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self {
            Some(v) => return Some(f(v)),
            None => return None,
        }
    }

    fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self {
            Some(v) => return Ok(v),
            None => return Err(err),
        }
    }
}

impl<T, E> Result<T, E> {
    fn is_ok(self) -> bool {
        if let Ok(_) = self {
            return true
        }
        return false
    }

    fn is_err(self) -> bool {
        if let Ok(_) = self {
            return false
        }
        return true
    }

    fn unwrap(self) -> T {
        match self {
            Ok(v) => return v,
            Err(_) => panic("called unwrap() on Err"),
        }
    }

    fn expect(self, msg: Str) -> T {
        match self {
            Ok(v) => return v,
            Err(_) => panic(msg),
        }
    }

    fn unwrap_err(self) -> E {
        match self {
            Ok(_) => panic("called unwrap_err() on Ok"),
            Err(e) => return e,
        }
    }

    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Ok(v) => return v,
            Err(_) => return fallback,
        }
    }

    fn ok(self) -> Option<T> {
        match self {
            Ok(v) => return Some(v),
            Err(_) => return None,
        }
    }

    fn err(self) -> Option<E> {
        match self {
            Ok(_) => return None,
            Err(e) => return Some(e),
        }
    }

    fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Ok(v) => return Ok(f(v)),
            Err(e) => return Err(e),
        }
    }
}
