fn main() {
    let a: u8 = 250
    let b = a + 5
    print(b, a as i8, -1i8 as u8, 300 as u8)
    let big: u64 = 0xFFFF_FFFF_FFFF_FFFF
    print(big, big / 3, big % 10, big > 1)
    print(255u8 +% 1, 0u8 -% 1, 200u8 *% 2, -128i8 -% 1)
    let x: u32 = 0xF0F0_1234
    print(x & 0xFFFF, x | 1, x ^ 0xFFFF_FFFF, ~x, !0u8)
    print(1u64 << 63, x >> 4, -16i32 >> 2, 0x80u8 >> 7)
    let s: i16 = -300
    print(s as i8, s as u16, s as i64, s as u8)
    let n: usize = 7
    print(n * 6, n as i32 - 10, 'A', '\n' as u8, 'z' - 'a')
    print(0b1010_1010, 0o17, 1_000_000)
    let mut m: u16 = 1
    m <<= 15
    m |= 3
    m ^= 1
    print(m)
    let neg: i32 = -7
    print(neg / 2, neg % 2, neg / -2, neg % -2)
    let q: u8 = 200
    print(q / 7, q % 7, q > 199, q < 100)
}

