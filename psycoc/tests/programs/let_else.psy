enum Shape {
    Circle(u64),
    Rect(u64, u64),
}

fn half(n: u64) -> Option<u64> {
    if n % 2 == 1 {
        return None
    }
    return Some(n / 2)
}

fn area(s: Shape) -> u64 {
    let Shape::Rect(w, h) = s else {
        return 0
    }
    return w * h
}

fn quarter(n: u64) -> Result<u64, u64> {
    let Some(a) = half(n) else {
        return Err(n)
    }
    let Some(b) = half(a) else {
        return Err(a)
    }
    return Ok(b)
}

fn main() {
    print(area(Shape::Rect(3, 4)), area(Shape::Circle(9)))
    print(quarter(40).unwrap(), quarter(42).unwrap_err(), quarter(7).unwrap_err())
    let mut found: u64 = 0
    for i in 0..10u64 {
        let Some(h) = half(i) else {
            continue
        }
        found += h
    }
    print(found)
}

//> 12 0
//> 10 21 7
//> 10
