const N: usize = 5
static mut COUNTER: u32 = 0
static PRIMES: [u16; 6] = [2, 3, 5, 7, 11, 13]

enum Op: u8 { Add, Mul = 10, Neg }

fn sum(s: &[i64]) -> i64 {
    let mut t = 0
    for i in 0..s.len() {
        t += s[i]
    }
    return t
}

fn fill(s: &mut [i64], v: i64) {
    for i in 0..s.len() { s[i] = v + i as i64 }
}

fn apply(op: Op, a: i64, b: i64) -> i64 {
    match op {
        Op::Add => return a + b,
        Op::Mul => return a * b,
        Op::Neg => return -a,
    }
}

fn twice(f: fn(i64) -> i64, x: i64) -> i64 { return f(f(x)) }
fn inc(x: i64) -> i64 { COUNTER += 1; return x + 1 }
fn square(x: i64) -> i64 { return x * x }

fn make() -> [u8; 4] { return [9, 8, 7, 6] }

fn main() {
    let mut a = [0i64; N]
    fill(&mut a, 10)
    print(a[0], a[4], sum(&a), sum(&a[1..3]), sum(&a[3..]), sum(&a[..0]))
    let s = &a[1..4]
    print(s.len(), s[0], s[2], sum(s))

    let grid = [[1u8, 2, 3], [4, 5, 6]]
    print(grid[1][2], grid[0][1], grid.len(), grid[0].len())

    let mut total: u32 = 0
    for i in 0..PRIMES.len() { total += PRIMES[i] as u32 }
    print(total)

    let mut i = 0
    let mut evens = 0
    loop {
        i += 1
        if i > 10 { break }
        if i % 2 == 1 { continue }
        evens += i
    }
    print(evens)

    print(apply(Op::Add, 2, 3), apply(Op::Mul, 2, 3), apply(Op::Neg, 2, 3), Op::Neg as u8)

    let f = square
    print(twice(inc, 5), twice(f, 3), COUNTER)

    let m = make()
    print(m[0], m[3], make()[1])

    let c = 'x'
    match c {
        'a' | 'e' | 'i' | 'o' | 'u' => print("vowel"),
        'x' => print("x!"),
        _ => print("other"),
    }

    let p = &mut a[2]
    *p = 99
    print(a[2])
}

//> 10 14 60 23 27 0
//> 3 11 13 36
//> 6 2 2 3
//> 41
//> 30
//> 5 6 -2 11
//> 7 81 2
//> 9 6 8
//> x!
//> 99
