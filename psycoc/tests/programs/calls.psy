fn sub(a: Int, b: Int) -> Int {
    return a - b
}

fn id(x: Int) -> Int {
    print(x)
    return x
}

fn fact(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

fn fib(n: Int) -> Int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    print(sub(10, 3), sub(3, 10))
    print(id(1) - id(2))
    print(id(3) + id(4) * id(5))
    print(id(20) / id(6), id(20) % id(6))
    print(id(1) < id(2))
    if id(9) >= id(9) { print("ge") }
    print(10 - fact(3), fact(3) - 10, fact(3) * fact(4))
    print(fact(20))
    print(fib(15))
}

